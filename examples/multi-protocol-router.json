{
  "name": "Multi-Protocol Router Topology",
  "description": "Demonstrates runtime protocol switching with OSPF, BGP, and RIP",
  "version": "1.0",
  "metadata": {
    "author": "Caduceus-Flux",
    "created": "2024-01-01",
    "tags": ["routing", "ospf", "bgp", "rip", "protocol-switching"]
  },
  "nodes": [
    {
      "name": "r1",
      "device_type": "router",
      "x": 200,
      "y": 150,
      "properties": {
        "router_daemon": "frr",
        "protocols": ["ospf", "bgp"],
        "router_id": "1.1.1.1",
        "interfaces": [
          {"name": "r1-eth0", "ip": "10.0.1.1/24"},
          {"name": "r1-eth1", "ip": "10.0.2.1/24"},
          {"name": "r1-eth2", "ip": "192.168.1.1/24"}
        ]
      }
    },
    {
      "name": "r2",
      "device_type": "router",
      "x": 400,
      "y": 150,
      "properties": {
        "router_daemon": "frr",
        "protocols": ["ospf", "bgp"],
        "router_id": "2.2.2.2",
        "interfaces": [
          {"name": "r2-eth0", "ip": "10.0.2.2/24"},
          {"name": "r2-eth1", "ip": "10.0.3.2/24"},
          {"name": "r2-eth2", "ip": "192.168.2.1/24"}
        ]
      }
    },
    {
      "name": "r3",
      "device_type": "router",
      "x": 300,
      "y": 300,
      "properties": {
        "router_daemon": "frr",
        "protocols": ["rip"],
        "router_id": "3.3.3.3",
        "interfaces": [
          {"name": "r3-eth0", "ip": "10.0.1.3/24"},
          {"name": "r3-eth1", "ip": "10.0.3.3/24"},
          {"name": "r3-eth2", "ip": "192.168.3.1/24"}
        ]
      }
    },
    {
      "name": "h1",
      "device_type": "host",
      "x": 100,
      "y": 50,
      "properties": {
        "ip": "192.168.1.10/24",
        "default_route": "via 192.168.1.1"
      }
    },
    {
      "name": "h2",
      "device_type": "host",
      "x": 500,
      "y": 50,
      "properties": {
        "ip": "192.168.2.10/24",
        "default_route": "via 192.168.2.1"
      }
    },
    {
      "name": "h3",
      "device_type": "host",
      "x": 300,
      "y": 450,
      "properties": {
        "ip": "192.168.3.10/24",
        "default_route": "via 192.168.3.1"
      }
    }
  ],
  "links": [
    {
      "source_node_id": "r1",
      "target_node_id": "r2",
      "source_port": "r1-eth1",
      "target_port": "r2-eth0",
      "bandwidth": 1000,
      "delay": 5,
      "properties": {"link_type": "backbone"}
    },
    {
      "source_node_id": "r1",
      "target_node_id": "r3",
      "source_port": "r1-eth0",
      "target_port": "r3-eth0",
      "bandwidth": 1000,
      "delay": 5,
      "properties": {"link_type": "backbone"}
    },
    {
      "source_node_id": "r2",
      "target_node_id": "r3",
      "source_port": "r2-eth1",
      "target_port": "r3-eth1",
      "bandwidth": 1000,
      "delay": 5,
      "properties": {"link_type": "backbone"}
    },
    {
      "source_node_id": "r1",
      "target_node_id": "h1",
      "source_port": "r1-eth2",
      "target_port": "h1-eth0",
      "bandwidth": 100,
      "delay": 1,
      "properties": {"link_type": "access"}
    },
    {
      "source_node_id": "r2",
      "target_node_id": "h2",
      "source_port": "r2-eth2",
      "target_port": "h2-eth0",
      "bandwidth": 100,
      "delay": 1,
      "properties": {"link_type": "access"}
    },
    {
      "source_node_id": "r3",
      "target_node_id": "h3",
      "source_port": "r3-eth2",
      "target_port": "h3-eth0",
      "bandwidth": 100,
      "delay": 1,
      "properties": {"link_type": "access"}
    }
  ],
  "controllers": [],
  "protocols": {
    "r1": {
      "ospf": {
        "area": "0.0.0.0",
        "networks": ["10.0.1.0/24", "10.0.2.0/24", "192.168.1.0/24"]
      },
      "bgp": {
        "as": 65001,
        "neighbors": [
          {"ip": "10.0.2.2", "remote_as": 65002}
        ]
      }
    },
    "r2": {
      "ospf": {
        "area": "0.0.0.0",
        "networks": ["10.0.2.0/24", "10.0.3.0/24", "192.168.2.0/24"]
      },
      "bgp": {
        "as": 65002,
        "neighbors": [
          {"ip": "10.0.2.1", "remote_as": 65001}
        ]
      }
    },
    "r3": {
      "rip": {
        "version": 2,
        "networks": ["10.0.1.0/24", "10.0.3.0/24", "192.168.3.0/24"]
      }
    }
  },
  "options": {
    "enable_routing": true,
    "protocol_switching_enabled": true,
    "hot_swap_protocols": ["ospf", "bgp", "rip", "isis", "eigrp"]
  }
}
