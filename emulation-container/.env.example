# Caduceus-Flux Emulation Container Environment Variables
# Copy this to .env and configure as needed

# =====================================================
# Emulation Container Configuration
# =====================================================

# gRPC Server Configuration
EMULATION_GRPC_HOST=host.docker.internal
EMULATION_GRPC_PORT=50051

# For host-based access (not in Docker)
# EMULATION_GRPC_HOST=localhost
# EMULATION_GRPC_HOST=127.0.0.1

# =====================================================
# Microservice Configuration (Docker)
# =====================================================

# All microservices that need emulation access should use:
EMULATION_GRPC_HOST=host.docker.internal
EMULATION_GRPC_PORT=50051

# =====================================================
# System Configuration
# =====================================================

# Python settings
PYTHONUNBUFFERED=1

# Log level
LOG_LEVEL=INFO

# =====================================================
# Optional: Advanced Configuration
# =====================================================

# Custom installation paths (if not using /opt defaults)
# GRPC_AGENT_PATH=/opt/grpc_agent
# EMULATION_CONFIG_PATH=/etc/caduceus-flux/emulation.yaml

# Systemd service configuration (automatically used)
# SYSTEMD_SERVICE_PATH=/etc/systemd/system/caduceus-emulation.service
