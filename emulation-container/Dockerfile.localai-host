# LocalAI Host Node Dockerfile
# This creates a main node with Workers mode enabled for model sharding

FROM localai/localai:latest-aio-cpu

# Set environment variables for host node
# Note: TOKEN should be provided as environment variable
ENV PORT=8080 \
    MODELS_PATH=/models/cache \
    WORKERS_MODE=true \
    P2P_NETWORK=p2p \
    P2P=true \
    DEBUG=true \
    LOG_LEVEL=info \
    DISABLE_AUTODOWNLOAD=true \
    AUTO_LOAD_MODELS=false \
    AUTOLOAD_GALLERIES=false \
    AUTOLOAD_BACKEND_GALLERIES=false \
    PRELOAD_MODELS='[]' \
    GALLERIES='[]' \
    BUILD_BACKENDS=false \
    PRELOAD_BACKENDS="llama-cpp"

# Create models directory
RUN mkdir -p /models /models/cache

# Create model configurations
RUN cat > /models/tinyllama.yaml << 'EOF'
name: tinyllama
backend: llama-cpp
context_size: 2048
f16: true
gpu_layers: 0
parameters:
  model: tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
  temperature: 0.7
  top_p: 0.9
  max_tokens: 512
EOF

RUN cat > /models/qwen2.yaml << 'EOF'
name: qwen2-1.5b
backend: llama-cpp
context_size: 4096
f16: true
gpu_layers: 0
parameters:
  model: Qwen2-1.5B-Instruct-Q4_K_M.gguf
  temperature: 0.6
  top_p: 0.95
  max_tokens: 1024
EOF

RUN cat > /models/stablelm.yaml << 'EOF'
name: stablelm-2b
backend: vllm
model: stabilityai/stablelm-2b-zephyr
temperature: 0.7
max_tokens: 1024
EOF

# Download models in background
RUN curl -L "https://huggingface.co/TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF/resolve/main/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf" \
         -o /models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf & \
    curl -L "https://huggingface.co/TheBloke/Qwen2-1.5B-Instruct-GGUF/resolve/main/qwen2-1.5b-instruct-q4_k_m.gguf" \
         -o /models/Qwen2-1.5B-Instruct-Q4_K_M.gguf & \
    wait

# Compatibility shims so legacy docker commands still work (/build/entrypoint.sh, local-ai)
RUN mkdir -p /build && \
    printf '#!/bin/bash\nexec /aio/entrypoint.sh "$@"\n' > /build/entrypoint.sh && \
    chmod +x /build/entrypoint.sh && \
    ln -sf /local-ai /usr/local/bin/local-ai

# Preinstall runtime backends so the UI reports them as available immediately
RUN local-ai backends install llama-cpp && \
    local-ai backends install whisper && \
    local-ai backends install stablediffusion-ggml && \
    local-ai backends install rfdetr && \
    (local-ai backends install vllm || echo "Skipping vllm backend preinstall (requires CUDA-enabled capability)")

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/readyz || exit 1

# Create custom entrypoint script (accepts both legacy envs (P2P/TOKEN) and newer LOCALAI_P2P/LOCALAI_P2P_TOKEN).
RUN cat > /entrypoint-host.sh << 'EOF'
#!/bin/bash
set -e

echo "🚀 LocalAI Host Node Starting"
echo "=============================="

P2P_VALUE="${P2P:-${LOCALAI_P2P:-}}"
if [ -n "$P2P_VALUE" ]; then
  export P2P="$P2P_VALUE"
  if [ -z "${LOCALAI_P2P:-}" ]; then
    export LOCALAI_P2P="$P2P_VALUE"
  fi
fi

TOKEN_VALUE="${TOKEN:-${LOCALAI_P2P_TOKEN:-}}"
if [ -n "$TOKEN_VALUE" ]; then
  export TOKEN="$TOKEN_VALUE"
  if [ -z "${LOCALAI_P2P_TOKEN:-}" ]; then
    export LOCALAI_P2P_TOKEN="$TOKEN_VALUE"
  fi
fi

echo "Port: ${PORT:-8080}"
echo "P2P Network: ${P2P_NETWORK:-p2p}"
echo "Workers Mode: ${WORKERS_MODE:-false}"
echo "P2P Enabled: ${P2P:-${LOCALAI_P2P:-false}}"
if [ -n "${TOKEN:-}" ]; then
  echo "Token: provided"
else
  echo "Token: auto-generated"
fi

MODELS_LIST="${MODELS:-/models/tinyllama.yaml,/models/qwen2.yaml}"
MODELS_LIST="${MODELS_LIST//[[:space:]]/}"

RUN_MODELS=()
IFS=',' read -r -a _MODELS_ARR <<< "$MODELS_LIST"
for m in "${_MODELS_ARR[@]}"; do
  if [ -n "$m" ]; then
    RUN_MODELS+=("$m")
  fi
done

ADDRESS=":${PORT:-8080}"
MODELS_PATH_VALUE="${MODELS_PATH:-/models/cache}"
LOG_LEVEL_VALUE="${LOG_LEVEL:-info}"
NETWORK_ID="${P2P_NETWORK_ID:-${LOCALAI_P2P_NETWORK_ID:-${P2P_NETWORK:-p2p}}}"

# If autodownload is disabled, ensure we don't auto-load remote galleries/models unless explicitly configured.
DISABLE_AUTODOWNLOAD_VALUE="${DISABLE_AUTODOWNLOAD:-${LOCALAI_DISABLE_AUTODOWNLOAD:-}}"
if [ "${DISABLE_AUTODOWNLOAD_VALUE,,}" = "true" ] || [ "${DISABLE_AUTODOWNLOAD_VALUE,,}" = "1" ]; then
  if [ -z "${AUTO_LOAD_MODELS+x}" ]; then export AUTO_LOAD_MODELS="false"; fi
  if [ -z "${PRELOAD_MODELS+x}" ]; then export PRELOAD_MODELS="[]"; fi
  if [ -z "${GALLERIES+x}" ]; then export GALLERIES="[]"; fi
  if [ -z "${AUTOLOAD_GALLERIES+x}" ]; then export AUTOLOAD_GALLERIES="false"; fi
  if [ -z "${AUTOLOAD_BACKEND_GALLERIES+x}" ]; then export AUTOLOAD_BACKEND_GALLERIES="false"; fi
fi

# MODELS_PATH should point to a directory without YAML configs to avoid autoloading every *.yaml in the shared volume.
# Keep YAML configs in /models but run with MODELS_PATH=/models/cache (seeded via the shared volume).
if [ -n "$MODELS_PATH_VALUE" ]; then
  mkdir -p "$MODELS_PATH_VALUE" 2>/dev/null || true
  if [ -d "/models" ] && [ "$MODELS_PATH_VALUE" != "/models" ]; then
    find /models -maxdepth 1 -type f ! -name '*.yaml' -exec ln -sf {} "$MODELS_PATH_VALUE"/ \; 2>/dev/null || true
  fi
fi

CMD=(local-ai run --address="$ADDRESS" --models-path="$MODELS_PATH_VALUE" --log-level="$LOG_LEVEL_VALUE")

if [ "${P2P:-${LOCALAI_P2P:-false}}" = "true" ] || [ "${P2P:-${LOCALAI_P2P:-false}}" = "1" ]; then
  CMD+=(--p2p --peer-2-peer-network-id="$NETWORK_ID")
  if [ -n "${TOKEN:-${LOCALAI_P2P_TOKEN:-}}" ]; then
    CMD+=(--p2ptoken="${TOKEN:-${LOCALAI_P2P_TOKEN}}")
  fi
fi

echo "MODELS_PATH: $MODELS_PATH_VALUE"
echo "MODELS: $MODELS_LIST"
echo "✅ Starting LocalAI server..."
exec "${CMD[@]}" "${RUN_MODELS[@]}"
EOF

RUN chmod +x /entrypoint-host.sh

# Use custom entrypoint
ENTRYPOINT ["/entrypoint-host.sh"]
