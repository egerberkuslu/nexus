{
  "name": "wsn-pegasis",
  "version": "1.0.0",
  "description": "PEGASIS - Power-Efficient Gathering in Sensor Information Systems (chain-based)",
  "node_class": "algorithm:PEGASISNode",
  "transport": "udp",
  "listen_port": 50000,
  "ip_family": "auto",
  "wsn_config": {
    "protocol": "pegasis",
    "max_rounds": 2000,
    "packet_size": 4000,
    "initial_energy": 0.5
  },
  "default_params": {
    "max_rounds": 2000,
    "packet_size": 4000,
    "initial_energy": 0.5,
    "discovery_seconds": 2.0,
    "chain_wait_time": 3.0,
    "leader_wait_time": 2.0,
    "round_time": 5.0
  }
}
