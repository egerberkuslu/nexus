{
  "name": "LocalAI P2P Cluster (1 Switch, 1 Master, 3 Workers)",
  "description": "Containernet topology: 1 OVS switch with 1 LocalAI master (host) and 3 LocalAI workers as dockerized hosts. Master publishes :8080 to host port 32778.",
  "version": "1.0",
  "metadata": {
    "author": "Caduceus-Flux",
    "tags": ["localai", "p2p", "cluster", "containernet", "dockerized-hosts"]
  },
  "nodes": [
    {
      "name": "s1",
      "device_type": "switch",
      "x": 400,
      "y": 180,
      "properties": {
        "switch_type": "ovs",
        "openflow_version": "1.3",
        "datapath_id": "00000000000000a1"
      }
    },
    {
      "name": "localai-host",
      "device_type": "host",
      "x": 150,
      "y": 320,
      "properties": {
        "dockerized": true,
        "ip": "10.0.0.10/24",
        "docker_image": "localai-host:latest",
        "docker_command": "/entrypoint-host.sh",
        "docker_volumes": [
          "localai-models:/models:rw"
        ],
        "docker_ports": {
          "8080/tcp": 32778
        },
        "docker_environment": {
          "PORT": "8080",
          "MODELS": "/models/tinyllama.yaml,/models/qwen2.yaml",
          "PROFILE": "cpu",
          "MODELS_PATH": "/models/cache",
          "DISABLE_AUTODOWNLOAD": "true",
          "AUTOLOAD_GALLERIES": "false",
          "AUTOLOAD_BACKEND_GALLERIES": "false",
          "WORKERS_MODE": "true",
          "P2P_NETWORK": "p2p",
          "P2P": "true",
          "LOCALAI_P2P": "true",
          "TOKEN": "REPLACE_ME_SHARED_P2P_TOKEN",
          "LOCALAI_P2P_TOKEN": "REPLACE_ME_SHARED_P2P_TOKEN",
          "LOG_LEVEL": "info",
          "DEBUG": "true",
          "AUTO_LOAD_MODELS": "false",
          "PRELOAD_MODELS": "[]",
          "GALLERIES": "[]",
          "BUILD_BACKENDS": "false",
          "PRELOAD_BACKENDS": "llama-cpp"
        }
      }
    },
    {
      "name": "localai-worker-1",
      "device_type": "host",
      "x": 300,
      "y": 380,
      "properties": {
        "dockerized": true,
        "ip": "10.0.0.11/24",
        "docker_image": "localai-worker:latest",
        "docker_command": "/entrypoint-worker.sh",
        "docker_volumes": [
          "localai-models:/models:rw"
        ],
        "docker_environment": {
          "WORKER_MODE": "true",
          "WORKER_ID": "worker-1",
          "P2P": "true",
          "LOCALAI_P2P": "true",
          "TOKEN": "REPLACE_ME_SHARED_P2P_TOKEN",
          "LOCALAI_P2P_TOKEN": "REPLACE_ME_SHARED_P2P_TOKEN",
          "LOG_LEVEL": "info",
          "DEBUG": "true",
          "MODELS_PATH": "/models/cache",
          "DISABLE_AUTODOWNLOAD": "true",
          "AUTOLOAD_GALLERIES": "false",
          "AUTOLOAD_BACKEND_GALLERIES": "false",
          "BUILD_BACKENDS": "false"
        }
      }
    },
    {
      "name": "localai-worker-2",
      "device_type": "host",
      "x": 500,
      "y": 380,
      "properties": {
        "dockerized": true,
        "ip": "10.0.0.12/24",
        "docker_image": "localai-worker:latest",
        "docker_command": "/entrypoint-worker.sh",
        "docker_volumes": [
          "localai-models:/models:rw"
        ],
        "docker_environment": {
          "WORKER_MODE": "true",
          "WORKER_ID": "worker-2",
          "P2P": "true",
          "LOCALAI_P2P": "true",
          "TOKEN": "REPLACE_ME_SHARED_P2P_TOKEN",
          "LOCALAI_P2P_TOKEN": "REPLACE_ME_SHARED_P2P_TOKEN",
          "LOG_LEVEL": "info",
          "DEBUG": "true",
          "MODELS_PATH": "/models/cache",
          "DISABLE_AUTODOWNLOAD": "true",
          "AUTOLOAD_GALLERIES": "false",
          "AUTOLOAD_BACKEND_GALLERIES": "false",
          "BUILD_BACKENDS": "false"
        }
      }
    },
    {
      "name": "localai-worker-3",
      "device_type": "host",
      "x": 650,
      "y": 320,
      "properties": {
        "dockerized": true,
        "ip": "10.0.0.13/24",
        "docker_image": "localai-worker:latest",
        "docker_command": "/entrypoint-worker.sh",
        "docker_volumes": [
          "localai-models:/models:rw"
        ],
        "docker_environment": {
          "WORKER_MODE": "true",
          "WORKER_ID": "worker-3",
          "P2P": "true",
          "LOCALAI_P2P": "true",
          "TOKEN": "REPLACE_ME_SHARED_P2P_TOKEN",
          "LOCALAI_P2P_TOKEN": "REPLACE_ME_SHARED_P2P_TOKEN",
          "LOG_LEVEL": "info",
          "DEBUG": "true",
          "MODELS_PATH": "/models/cache",
          "DISABLE_AUTODOWNLOAD": "true",
          "AUTOLOAD_GALLERIES": "false",
          "AUTOLOAD_BACKEND_GALLERIES": "false",
          "BUILD_BACKENDS": "false"
        }
      }
    }
  ],
  "links": [
    {
      "source_node_id": "localai-host",
      "target_node_id": "s1",
      "bandwidth": 1000,
      "delay": 1,
      "loss": 0,
      "max_queue_size": 1000,
      "properties": {}
    },
    {
      "source_node_id": "localai-worker-1",
      "target_node_id": "s1",
      "bandwidth": 1000,
      "delay": 1,
      "loss": 0,
      "max_queue_size": 1000,
      "properties": {}
    },
    {
      "source_node_id": "localai-worker-2",
      "target_node_id": "s1",
      "bandwidth": 1000,
      "delay": 1,
      "loss": 0,
      "max_queue_size": 1000,
      "properties": {}
    },
    {
      "source_node_id": "localai-worker-3",
      "target_node_id": "s1",
      "bandwidth": 1000,
      "delay": 1,
      "loss": 0,
      "max_queue_size": 1000,
      "properties": {}
    }
  ],
  "controllers": [],
  "options": {
    "autoSetMacs": true,
    "xterms": false,
    "ipBase": "10.0.0.0/24"
  }
}
