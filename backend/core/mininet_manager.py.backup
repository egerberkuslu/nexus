    def create_simple_topology(self):
        """Create the default network topology with controller visibility"""
        try:
            # Clean any existing Mininet processes
            os.system('mn -c > /dev/null 2>&1')
            
            # Create network with RemoteController
            self.net = Mininet(
                controller=lambda name: RemoteController(name, ip='127.0.0.1', port=6633),
                switch=OVSKernelSwitch,
                link=TCLink,
                host=Host,
                autoSetMacs=True,
                autoStaticArp=False
            )
            
            # Add controller - THIS IS NOW TRACKED
            c0 = self.net.addController('c0', controller=RemoteController, 
                                      ip='127.0.0.1', port=6633)
            
            # Add switches
            s1 = self.net.addSwitch('s1', protocols='OpenFlow13')
            s2 = self.net.addSwitch('s2', protocols='OpenFlow13')
            
            # Add router
            r1 = self.net.addHost('r1', cls=Router, ip='10.0.1.1/24')
            
            # Add hosts in different subnets
            h1 = self.net.addHost('h1', ip='10.0.1.10/24', defaultRoute='via 10.0.1.1')
            h2 = self.net.addHost('h2', ip='10.0.1.11/24', defaultRoute='via 10.0.1.1')
            h3 = self.net.addHost('h3', ip='10.0.2.10/24', defaultRoute='via 10.0.2.1')
            h4 = self.net.addHost('h4', ip='10.0.2.11/24', defaultRoute='via 10.0.2.1')
            
            # Add links
            self.net.addLink(h1, s1, bw=10)
            self.net.addLink(h2, s1, bw=10)
            self.net.addLink(r1, s1, bw=100, intfName1='r1-eth0')
            
            self.net.addLink(h3, s2, bw=10)
            self.net.addLink(h4, s2, bw=10)
            self.net.addLink(r1, s2, bw=100, intfName1='r1-eth1')
            
            # Store the simple topology configuration for snapshots
            self._stored_topology = {
                'nodes': [
                    {'id': 'c0', 'type': 'controller', 'ip': '127.0.0.1', 'port': 6633, 'x': 400, 'y': 50},
                    {'id': 's1', 'type': 'switch', 'x': 200, 'y': 150},
                    {'id': 's2', 'type': 'switch', 'x': 600, 'y': 150},
                    {'id': 'r1', 'type': 'router', 'ip': '10.0.1.1/24', 'x': 400, 'y': 150},
                    {'id': 'h1', 'type': 'host', 'ip': '10.0.1.10/24', 'x': 100, 'y': 250},
                    {'id': 'h2', 'type': 'host', 'ip': '10.0.1.11/24', 'x': 300, 'y': 250},
                    {'id': 'h3', 'type': 'host', 'ip': '10.0.2.10/24', 'x': 500, 'y': 250},
                    {'id': 'h4', 'type': 'host', 'ip': '10.0.2.11/24', 'x': 700, 'y': 250}
                ],
                'links': [
                    {'source': 'h1', 'target': 's1', 'bandwidth': 10},
                    {'source': 'h2', 'target': 's1', 'bandwidth': 10},
                    {'source': 'r1', 'target': 's1', 'bandwidth': 100},
                    {'source': 'h3', 'target': 's2', 'bandwidth': 10},
                    {'source': 'h4', 'target': 's2', 'bandwidth': 10},
                    {'source': 'r1', 'target': 's2', 'bandwidth': 100}
                ],
                'controllers': [{'id': 'c0', 'type': 'controller', 'ip': '127.0.0.1', 'port': 6633}],
                'stats': {}
            }
            
            # Store node positions and controller config
            self.node_positions = {
                'c0': {'x': 400, 'y': 50},
                's1': {'x': 200, 'y': 150},
                's2': {'x': 600, 'y': 150},
                'r1': {'x': 400, 'y': 150},
                'h1': {'x': 100, 'y': 250},
                'h2': {'x': 300, 'y': 250},
                'h3': {'x': 500, 'y': 250},
                'h4': {'x': 700, 'y': 250}
            }
            self.controller_config = [{'id': 'c0', 'type': 'controller', 'ip': '127.0.0.1', 'port': 6633}]
            
            logger.info("Simple topology created successfully")
            self._print_topology_info()
            
            return True
            
        except Exception as e:
            logger.error(f"Error creating topology: {e}")
            return False

    
    def _is_valid_mac(self, mac_address):
        """Validate MAC address format"""
        if not mac_address or mac_address.lower() == 'auto':
            return False
        
        # Check if MAC address matches expected format
        mac_pattern = r'^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$'
        return bool(re.match(mac_pattern, mac_address))
    
    def _is_valid_dpid(self, dpid):
        """Validate DPID format"""
        if not dpid or dpid.lower() == 'auto':
            return False
        
        try:
            # DPID should be a hex string
            int(dpid, 16)
            return True
        except ValueError:
            return False
        """Validate DPID format"""
        if not dpid or dpid.lower() == 'auto':
            return False
        
        try:
            # DPID should be a hex string
            int(dpid, 16)
            return True
        except ValueError:
            return False

    def create_custom_topology(self, topology_config, controller_type=None, controller_app=None,
                              controller_port=None, switch_type='ovs'):
        """Create custom topology from configuration with optional controller specification"""
        # Delegate to topology manager
        net, success = self.topology_manager.create_custom_topology(
            topology_config, controller_type, controller_app, controller_port, switch_type
        )

        if success and net:
            self.net = net
            self.is_running = True
            # Update our topology data from the manager
            self.topology_manager.update_topology_data(net)
            self.topology_data = self.topology_manager.topology_data
            return True

        return False

    def update_topology_data(self):
        """Update topology data including controller information, node positions, and controller links"""
        # Delegate to topology manager
        self.topology_manager.update_topology_data(self.net)
        self.topology_data = self.topology_manager.topology_data

        # Legacy implementation (commented out)
        """
        self.topology_data = {
            'nodes': [],
            'links': [],
            'controllers': [],
            'stats': {}
        }
        if not self.net:
            return

        # Collect all controller information, prioritizing config over default
        controllers_added = set()
        
        # First, add controllers from stored config (these have positions and custom IDs)
        if hasattr(self, 'controller_config'):
            for controller_node in self.controller_config:
                controller_id = controller_node.get('id')
                
                # Get controller status from factory
                active_controller = self.controller_factory.get_active_controller()
                if active_controller:
                    controller_info = self.controller_factory.get_controller_info().get(active_controller, {})
                    is_running = controller_info.get('running', False)
                    controller_app = controller_info.get('current_app', 'unknown')
                else:
                    is_running = False
                    controller_app = 'unknown'
                
                node_controller_info = {
                    'id': controller_id,
                    'type': 'controller',
                    'ip': controller_node.get('ip', '127.0.0.1'),
                    'port': controller_node.get('port', 6633),
                    'status': 'active' if is_running else 'inactive',
                    'controller_type': controller_app,
                    'controller_framework': active_controller,
                    'protocol': 'OpenFlow',
                    'version': '1.3'
                }
                if hasattr(self, 'node_positions') and controller_id in self.node_positions:
                    node_controller_info.update(self.node_positions[controller_id])
                self.topology_data['controllers'].append(node_controller_info)
                
                # Also add to nodes list for visualization
                # Get controller status from factory
                active_controller = self.controller_factory.get_active_controller()
                controller_status = 'inactive'
                if active_controller:
                    controller_info = self.controller_factory.get_controller_info().get(active_controller, {})
                    controller_status = 'active' if controller_info.get('running', False) else 'inactive'

                node_info = {
                    'id': controller_id,
                    'type': 'controller',
                    'ip': controller_node.get('ip', '127.0.0.1'),
                    'mac': 'N/A',
                    'status': controller_status
                }
                if hasattr(self, 'node_positions') and controller_id in self.node_positions:
                    node_info.update(self.node_positions[controller_id])
                self.topology_data['nodes'].append(node_info)
                
                controllers_added.add(controller_id)
        
        # Then, add any additional controllers from Mininet that weren't in config
        if hasattr(self.net, 'controllers') and self.net.controllers:
            for controller in self.net.controllers:
                # Skip if this controller name matches any controller node ID
                if controller.name not in controllers_added:
                    # Check if this Mininet controller corresponds to a controller node
                    controller_node_match = None
                    if hasattr(self, 'controller_config'):
                        for controller_node in self.controller_config:
                            if (controller_node.get('ip', '127.0.0.1') == getattr(controller, 'ip', '127.0.0.1') and 
                                controller_node.get('port', 6633) == getattr(controller, 'port', 6633)):
                                controller_node_match = controller_node
                                break
                    
                    # If this Mininet controller matches a controller node, skip it (already added above)
                    if controller_node_match:
                        self.logger.info(f"Skipping Mininet controller {controller.name} - matches controller node {controller_node_match.get('id')}")
                        continue
                    
                    # Get controller status from factory
                    active_controller = self.controller_factory.get_active_controller()
                    if active_controller:
                        controller_info = self.controller_factory.get_controller_info().get(active_controller, {})
                        is_running = controller_info.get('running', False)
                        controller_app = controller_info.get('current_app', 'unknown')
                    else:
                        is_running = False
                        controller_app = 'unknown'
                    
                    mininet_controller_info = {
                        'id': controller.name,
                        'type': 'controller',
                        'ip': getattr(controller, 'ip', '127.0.0.1'),
                        'port': getattr(controller, 'port', 6633),
                        'status': 'active' if is_running else 'inactive',
                        'controller_type': controller_app,
                        'controller_framework': active_controller,
                        'protocol': 'OpenFlow',
                        'version': '1.3'
                    }
                    if hasattr(self, 'node_positions') and controller.name in self.node_positions:
                        mininet_controller_info.update(self.node_positions[controller.name])
                    self.topology_data['controllers'].append(mininet_controller_info)

                    # Also include in nodes list for visualization
                    node_info = {
                        'id': controller.name,
                        'type': 'controller',
                        'ip': getattr(controller, 'ip', '127.0.0.1'),
                        'mac': 'N/A',
                        'status': 'active' if controller.is_running else 'inactive'
                    }
                    if hasattr(self, 'node_positions') and controller.name in self.node_positions:
                        node_info.update(self.node_positions[controller.name])
                    self.topology_data['nodes'].append(node_info)
                    
                    controllers_added.add(controller.name)

        # Add network nodes (hosts, routers, switches)
        for node in self.net.hosts + self.net.switches:
            # Determine node type with improved router detection
            if isinstance(node, Router):
                node_type = 'router'
            elif hasattr(node, 'node_type') and node.node_type == 'router':
                node_type = 'router'
            elif hasattr(node, 'get_type') and callable(node.get_type):
                try:
                    node_type = node.get_type()
                except:
                    node_type = 'host' if isinstance(node, Host) else 'switch'
            elif isinstance(node, Host):
                node_type = 'host'
            else:
                node_type = 'switch'

            try:
                # Try to get IP from default interface first, then fallback to node.IP()
                if node_type in ['host', 'router'] and hasattr(node, 'defaultIntf') and node.defaultIntf():
                    try:
                        node_ip = node.defaultIntf().IP() if hasattr(node.defaultIntf(), 'IP') else ''
                    except:
                        node_ip = node.IP() if hasattr(node, 'IP') else ''
                else:
                    node_ip = node.IP() if hasattr(node, 'IP') and node_type in ['host', 'router'] else ''
            except Exception:
                node_ip = ''
            try:
                # Try to get MAC from default interface first, then fallback to node.MAC()
                if node_type in ['host', 'router'] and hasattr(node, 'defaultIntf') and node.defaultIntf():
                    try:
                        node_mac = node.defaultIntf().MAC() if hasattr(node.defaultIntf(), 'MAC') else 'N/A'
                    except:
                        node_mac = node.MAC() if hasattr(node, 'MAC') else 'N/A'
                else:
                    node_mac = node.MAC() if hasattr(node, 'MAC') and node_type in ['host', 'router'] else 'N/A'
            except Exception:
                node_mac = 'N/A'

            node_info = {
                'id': node.name,
                'type': node_type,
                'ip': node_ip,
                'mac': node_mac,
                'status': 'active' if self.is_running else 'inactive'
            }
            if hasattr(self, 'node_positions') and node.name in self.node_positions:
                node_info.update(self.node_positions[node.name])

            # Add interface information for routers
            if node_type == 'router':
                interfaces = []
                for intf in node.intfList():
                    if intf.name != 'lo':
                        try:
                            interfaces.append({
                                'name': intf.name,
                                'ip': intf.IP() if hasattr(intf, 'IP') else 'unknown',
                                'mac': intf.MAC() if hasattr(intf, 'MAC') else 'unknown'
                            })
                        except:
                            interfaces.append({
                                'name': intf.name,
                                'ip': 'unknown',
                                'mac': 'unknown'
                            })
                node_info['interfaces'] = interfaces

            # Add port information for switches
            elif node_type == 'switch':
                ports = []
                for intf in node.intfList():
                    if intf.name != 'lo':
                        ports.append({
                            'name': intf.name,
                            'port': getattr(intf, 'port', 'unknown'),
                            'link': getattr(intf, 'link', None) is not None
                        })
                node_info['ports'] = ports
                if self.is_running:
                    # Only set controller if one exists
                    if self.topology_data['controllers']:
                        node_info['controller'] = self.topology_data['controllers'][0]['id']
                    else:
                        node_info['controller'] = 'none'
                    node_info['openflow_version'] = '1.3'

            self.topology_data['nodes'].append(node_info)

        # Add physical links from Mininet
        for link in self.net.links:
            try:
                # Try to get bandwidth from interface configuration
                bw = 'unknown'
                if hasattr(link, 'intf1') and link.intf1:
                    try:
                        # Check if interface has bandwidth configuration
                        if hasattr(link.intf1, 'params') and 'bw' in link.intf1.params:
                            bw = link.intf1.params['bw']
                        elif hasattr(link.intf1, 'config') and hasattr(link.intf1.config, 'bw'):
                            bw = link.intf1.config.bw
                        elif hasattr(link.intf1, 'bw'):
                            bw = link.intf1.bw
                        
                        if bw != 'unknown' and bw is not None:
                            # Convert to human-readable format
                            if bw >= 1000:
                                bw = f"{bw/1000:.0f}Gbit"
                            else:
                                bw = f"{bw}Mbit"
                    except Exception as e:
                        logger.debug(f"Error reading bandwidth for link {link}: {e}")
                        bw = 'unknown'
            except Exception as e:
                logger.debug(f"Error processing link {link}: {e}")
                bw = 'unknown'
                
            # Check link status by checking if interfaces are up
            link_status = 'down'
            try:
                if (hasattr(link, 'intf1') and link.intf1 and hasattr(link.intf1, 'isUp') and link.intf1.isUp()) and \
                   (hasattr(link, 'intf2') and link.intf2 and hasattr(link.intf2, 'isUp') and link.intf2.isUp()):
                    link_status = 'up'
            except Exception as e:
                logger.debug(f"Error checking link status for {link}: {e}")
                link_status = 'up' if self.is_running else 'down'
                
            self.topology_data['links'].append({
                'source': link.intf1.node.name,
                'target': link.intf2.node.name,
                'type': 'physical',
                'bandwidth': bw,
                'status': link_status
            })

        # Add controller links from original topology configuration
        if hasattr(self, 'original_topology_config'):
            original_links = self.original_topology_config.get('links', [])
            controller_ids = [c['id'] for c in self.topology_data['controllers']]
            
            for link in original_links:
                source = link.get('source')
                target = link.get('target')
                
                # Check if this is a controller link
                if source in controller_ids or target in controller_ids:
                    # Verify both nodes exist in our topology
                    all_node_ids = [n['id'] for n in self.topology_data['nodes']]
                    if source in all_node_ids and target in all_node_ids:
                        self.topology_data['links'].append({
                            'source': source,
                            'target': target,
                            'type': 'control',
                            'bandwidth': 'N/A',
                            'status': 'up' if self.is_running else 'down'
                        })

        # If we don't have the original config, create default controller links to all switches
        elif self.topology_data['controllers']:
            switch_nodes = [n for n in self.topology_data['nodes'] if n['type'] == 'switch']
            
            for controller in self.topology_data['controllers']:
                for switch in switch_nodes:
                    self.topology_data['links'].append({
                        'source': controller['id'],
                        'target': switch['id'],
                        'type': 'control',
                        'bandwidth': 'N/A',
                        'status': 'up' if self.is_running else 'down'
                    })

        # Add statistics
        router_count = len([node for node in self.net.hosts if isinstance(node, Router) or 
                        (hasattr(node, 'node_type') and node.node_type == 'router')])
        host_count = len(self.net.hosts) - router_count
        self.topology_data['stats'] = {
            'hosts': host_count,
            'routers': router_count,
            'switches': len(self.net.switches),
            'controllers': len(self.topology_data['controllers']),
            'links': len(self.topology_data['links']),
            'status': 'running' if self.is_running else 'stopped',
            'controller_status': self.get_controller_status()
        }
        """


    def _parse_frontend_topology(self, frontend_topology):
        """Parse frontend topology format to backend format"""
        try:
            # Handle both direct config and nested topology
            if 'topology' in frontend_topology:
                config = frontend_topology['topology']
            else:
                config = frontend_topology
            
            # Separate nodes by type
            parsed = {
                'name': config.get('name', 'Custom Topology'),
                'hosts': [],
                'switches': [],
                'routers': [],
                'controllers': [],
                'links': config.get('links', [])
            }
            
            # Process nodes and separate by type
            for node in config.get('nodes', []):
                node_type = node.get('type', 'host')
                node_data = {
                    'id': node['id'],
                    'ip': node.get('ip', 'auto'),
                    'type': node_type
                }
                
                # Add type-specific attributes
                if node_type == 'switch':
                    node_data['dpid'] = node.get('dpid', 'auto')
                    node_data['openflow_version'] = node.get('openflow_version', '1.3')
                    parsed['switches'].append(node_data)
                elif node_type == 'router':
                    node_data['routing_protocol'] = node.get('routing_protocol', 'static')
                    parsed['routers'].append(node_data)
                elif node_type == 'controller':
                    node_data['port'] = node.get('port', 6633)
                    parsed['controllers'].append(node_data)
                else:  # host
                    node_data['mac'] = node.get('mac', 'auto')
                    parsed['hosts'].append(node_data)
            
            return parsed
            
        except Exception as e:
            logger.error(f"Error parsing frontend topology: {e}")
            raise e


    def create_predefined_topology(self, topology_config):
        """Create predefined topology types"""
        try:
            topo_type = topology_config.get('type', 'simple')
            
            # Clean any existing processes
            os.system('mn -c > /dev/null 2>&1')
            
            if topo_type == 'simple':
                hosts = topology_config.get('hosts', 2)
                switches = topology_config.get('switches', 1)
                self.net = Mininet(topo=SingleSwitchTopo(k=hosts))
                
            elif topo_type == 'linear':
                hosts = topology_config.get('hosts', 4)
                switches = topology_config.get('switches', 4)
                self.net = Mininet(topo=LinearTopo(k=hosts))
                
            elif topo_type == 'tree':
                depth = topology_config.get('depth', 3)
                fanout = topology_config.get('fanout', 2)
                self.net = Mininet(topo=TreeTopo(depth=depth, fanout=fanout))
                
            elif topo_type == 'star':
                hosts = topology_config.get('hosts', 6)
                # Star topology is essentially a single switch topology
                self.net = Mininet(topo=SingleSwitchTopo(k=hosts))
                
            elif topo_type == 'mesh':
                hosts = topology_config.get('hosts', 4)
                # Create a mesh topology using custom implementation
                self.net = Mininet(topo=self._create_mesh_topology(hosts))
                
            elif topo_type == 'ring':
                hosts = topology_config.get('hosts', 6)
                # Create a ring topology
                self.net = Mininet(topo=self._create_ring_topology(hosts))
                
            elif topo_type == 'fattree':
                k = topology_config.get('k', 4)  # k-ary fat tree
                # Create fat tree topology
                self.net = Mininet(topo=self._create_fattree_topology(k))
                
            elif topo_type == 'datacenter':
                pods = topology_config.get('pods', 4)
                hosts_per_pod = topology_config.get('hosts_per_pod', 2)
                # Create datacenter-like topology
                self.net = Mininet(topo=self._create_datacenter_topology(pods, hosts_per_pod))
                
            else:
                logger.error(f"Unknown predefined topology type: {topo_type}")
                return False
            
            # Set controller if specified
            controller_config = topology_config.get('controller', {})
            if controller_config:
                controller_type = controller_config.get('type', 'ovs')
                controller_ip = controller_config.get('ip', '127.0.0.1')
                controller_port = controller_config.get('port', 6633)
                
                if controller_type == 'remote':
                    self.net.addController('c0', controller=RemoteController, 
                                         ip=controller_ip, port=controller_port)
                elif controller_type == 'ryu':
                    # Use Ryu controller
                    self.net.addController('c0', controller=RemoteController, 
                                         ip=controller_ip, port=controller_port)
            
            # Configure link parameters if specified
            link_config = topology_config.get('links', {})
            if link_config:
                bandwidth = link_config.get('bandwidth', None)
                delay = link_config.get('delay', None)
                loss = link_config.get('loss', None)
                
                # Apply link configuration to all links
                for link in self.net.links:
                    if bandwidth:
                        link.intf1.config(bw=bandwidth)
                        link.intf2.config(bw=bandwidth)
                    if delay:
                        link.intf1.config(delay=delay)
                        link.intf2.config(delay=delay)
                    if loss:
                        link.intf1.config(loss=loss)
                        link.intf2.config(loss=loss)
            
            logger.info(f"Created predefined topology: {topo_type}")
            return True
            
        except Exception as e:
            logger.error(f"Error creating predefined topology: {e}")
            return False

    def _create_mesh_topology(self, num_hosts):
        """Create a mesh topology where all switches are connected"""
        from mininet.topo import Topo
        
        class MeshTopo(Topo):
            def __init__(self, hosts=4):
                Topo.__init__(self)
                
                # Add switches
                switches = []
                for i in range(hosts):
                    switch = self.addSwitch(f's{i+1}')
                    switches.append(switch)
                    
                    # Add host connected to this switch
                    host = self.addHost(f'h{i+1}')
                    self.addLink(host, switch)
                
                # Connect all switches to each other (full mesh)
                for i in range(len(switches)):
                    for j in range(i+1, len(switches)):
                        self.addLink(switches[i], switches[j])
        
        return MeshTopo(num_hosts)

    def _create_ring_topology(self, num_hosts):
        """Create a ring topology"""
        from mininet.topo import Topo
        
        class RingTopo(Topo):
            def __init__(self, hosts=6):
                Topo.__init__(self)
                
                # Add switches and hosts
                switches = []
                for i in range(hosts):
                    switch = self.addSwitch(f's{i+1}')
                    switches.append(switch)
                    
                    # Add host connected to this switch
                    host = self.addHost(f'h{i+1}')
                    self.addLink(host, switch)
                
                # Connect switches in a ring
                for i in range(len(switches)):
                    next_switch = switches[(i + 1) % len(switches)]
                    self.addLink(switches[i], next_switch)
        
        return RingTopo(num_hosts)

    def _create_fattree_topology(self, k):
        """Create a k-ary fat tree topology"""
        from mininet.topo import Topo
        
        class FatTreeTopo(Topo):
            def __init__(self, k=4):
                Topo.__init__(self)
                
                # Core switches
                core_switches = []
                for i in range((k//2)**2):
                    core = self.addSwitch(f'core{i+1}')
                    core_switches.append(core)
                
                # Pod switches and hosts
                pods = k
                for pod in range(pods):
                    # Aggregation switches in this pod
                    agg_switches = []
                    for i in range(k//2):
                        agg = self.addSwitch(f'agg{pod}_{i}')
                        agg_switches.append(agg)
                    
                    # Edge switches in this pod
                    edge_switches = []
                    for i in range(k//2):
                        edge = self.addSwitch(f'edge{pod}_{i}')
                        edge_switches.append(edge)
                        
                        # Connect hosts to edge switches
                        for j in range(k//2):
                            host = self.addHost(f'h{pod}_{i}_{j}')
                            self.addLink(host, edge)
                    
                    # Connect edge to aggregation switches
                    for edge in edge_switches:
                        for agg in agg_switches:
                            self.addLink(edge, agg)
                    
                    # Connect aggregation switches to core switches
                    for i, agg in enumerate(agg_switches):
                        for j in range(k//2):
                            core_idx = i * (k//2) + j
                            if core_idx < len(core_switches):
                                self.addLink(agg, core_switches[core_idx])
        
        return FatTreeTopo(k)

    def _create_datacenter_topology(self, pods, hosts_per_pod):
        """Create a datacenter-like topology"""
        from mininet.topo import Topo
        
        class DatacenterTopo(Topo):
            def __init__(self, pods=4, hosts_per_pod=2):
                Topo.__init__(self)
                
                # Core switch
                core = self.addSwitch('core1')
                
                # Pod switches and hosts
                for pod in range(pods):
                    # Top of rack switch for this pod
                    tor = self.addSwitch(f'tor{pod+1}')
                    self.addLink(core, tor)
                    
                    # Hosts in this pod
                    for host in range(hosts_per_pod):
                        h = self.addHost(f'h{pod+1}_{host+1}')
                        self.addLink(h, tor)
        
        return DatacenterTopo(pods, hosts_per_pod)

    def _parse_bandwidth(self, bw_string):
        """Parse bandwidth string to numeric value in Mbps"""
        try:
            if isinstance(bw_string, (int, float)):
                return bw_string
            
            bw_string = str(bw_string).upper()
            
            # Remove whitespace
            bw_string = bw_string.replace(' ', '')
            
            # Parse numeric part and unit
            import re
            match = re.match(r'(\d+(?:\.\d+)?)(.*)', bw_string)
            if not match:
                logger.warning(f"Could not parse bandwidth '{bw_string}', using default 10 Mbps")
                return 10
            
            value = float(match.group(1))
            unit = match.group(2).upper()
            
            # Convert to Mbps
            if unit in ['', 'M', 'MBPS', 'MB/S']:
                return value
            elif unit in ['K', 'KBPS', 'KB/S']:
                return value / 1000
            elif unit in ['G', 'GBPS', 'GB/S']:
                return value * 1000
            else:
                logger.warning(f"Unknown bandwidth unit '{unit}', treating as Mbps")
                return value
                
        except Exception as e:
            logger.warning(f"Error parsing bandwidth '{bw_string}': {e}, using default 10 Mbps")
            return 10
    
    def _configure_router(self, router):
        """Configure router interfaces and routing"""
        try:
            # Configure router interfaces
            router.cmd('ifconfig r1-eth0 10.0.1.1/24')
            router.cmd('ifconfig r1-eth1 10.0.2.1/24')
            
            # Add routing table entries
            router.cmd('ip route add 10.0.1.0/24 dev r1-eth0')
            router.cmd('ip route add 10.0.2.0/24 dev r1-eth1')
            
            logger.info("Router configured successfully")
            
        except Exception as e:
            logger.error(f"Error configuring router: {e}")
    
    def _print_topology_info(self):
        """Print topology information"""
        info("*** Topology Information:\n")
        info("Subnet 1 (10.0.1.0/24):\n")
        info("  - h1: 10.0.1.10/24 -> s1\n")
        info("  - h2: 10.0.1.11/24 -> s1\n")
        info("  - r1-eth0: 10.0.1.1/24 -> s1\n")
        info("Subnet 2 (10.0.2.0/24):\n")
        info("  - h3: 10.0.2.10/24 -> s2\n")
        info("  - h4: 10.0.2.11/24 -> s2\n")
        info("  - r1-eth1: 10.0.2.1/24 -> s2\n")
        info("Router: r1 (connects s1 and s2)\n")
        info("Controller: c0 (127.0.0.1:6633)\n")
    
    
    def start_network(self):
        """Start the network"""
        try:
            if not self.net:
                self.logger.error("No network to start. Create topology first.")
                return False
            
            self.logger.info("Starting Mininet network")
            self.net.start()
            
            # Wait a moment for network to stabilize
            import time
            time.sleep(2)
            
            # Test connectivity
            self.logger.info("Testing network connectivity")            
            self.is_running = True
            
            # Start statistics collection if available
            if hasattr(self, 'stats_collector'):
                self.stats_collector.start_collection()
            
            return True
            
        except Exception as e:
            self.logger.error(f"Error starting network: {e}")
            return False
        
    def stop_network(self):
        """Stop the Mininet network and Ryu controller"""
        try:
            # Stop statistics collection
            self.stats_collector.stop_collection()
            
            if self.net:
                self.net.stop()
                self.is_running = False
                logger.info("Mininet network stopped")
            
            self.stop_ryu_controller()
            self.net = None
            
            # Clear topology data
            self.topology_data = {
                'nodes': [],
                'links': [],
                'controllers': [],
                'stats': {}
            }
            
            return True
            
        except Exception as e:
            logger.error(f"Error stopping network: {e}")
            return False

    def ping_test(self):
        """Run ping test between all hosts"""
        if not self.net or not self.is_running:
            return {'error': 'Network not running'}
        
        try:
            logger.info("Running ping test")
            result = self.net.pingAll()
            packet_loss = re.search(r'(\d+)% packet loss', str(result))
            loss_percent = packet_loss.group(1) if packet_loss else '0'
            
            return {
                'result': f'Ping test completed with {loss_percent}% packet loss',
                'success': True,
                'packet_loss': loss_percent
            }
        except Exception as e:
            logger.error(f"Ping test failed: {e}")
            return {'error': f'Ping test failed: {str(e)}', 'success': False}
    
    def get_flow_stats(self):
        """Get flow statistics from switches"""
        # Delegate to flow manager
        return self.flow_manager.get_flow_stats(self.net)

    # ===============
    # Dynamic changes
    # ===============
    def _ensure_net_running(self):
        """Helper to ensure network object exists; returns (ok, error_msg)."""
        if not self.net:
            return False, 'Network not created'
        # Check if network is running, but be lenient about method availability
        if hasattr(self.net, 'running') and not self.net.running:
            logger.warning("Network exists but is not running")
            # Don't fail, just warn
        return True, None

    def _maybe_apply_controller_to_switch(self, switch_obj):
        """If a controller is configured/running, point the switch to it and set OF version."""
        try:
            # Configure OpenFlow13 if controller exists
            if self.topology_data.get('controllers'):
                switch_obj.cmd('ovs-vsctl set bridge %s protocols=OpenFlow13' % switch_obj.name)
                # Point to first controller in topology_data
                ctrl = self.topology_data['controllers'][0]
                ctrl_target = f"tcp:{ctrl.get('ip','127.0.0.1')}:{ctrl.get('port',6633)}"
                switch_obj.cmd('ovs-vsctl set-controller %s %s' % (switch_obj.name, ctrl_target))
        except Exception as e:
            logger.warning(f"Could not configure controller for {switch_obj.name}: {e}")
        """

    def add_node(self, node_id, node_type='host', **kwargs):
        """Add a node (host/switch/router) to running topology without restart."""
        # Delegate to topology manager
        node = self.topology_manager.add_node(self.net, node_id, node_type, **kwargs)
        return {'success': node is not None, 'node': node}

        # Legacy implementation (commented out)
        """
        ok, err = self._ensure_net_running()
        if not ok:
            return {'success': False, 'error': err}

        try:
            # Check if network exists and is properly initialized
            if not self.net:
                return {'success': False, 'error': 'Network not initialized'}
                
            # Debug network object state
            logger.info(f"Adding node {node_id} of type {node_type}")
            logger.info(f"Network object type: {type(self.net).__name__}")
            logger.info(f"Network running: {getattr(self.net, 'running', 'unknown')}")
            logger.info(f"Network hosts: {len(getattr(self.net, 'hosts', []))}")
            logger.info(f"Network switches: {len(getattr(self.net, 'switches', []))}")
            logger.info(f"Network links: {len(getattr(self.net, 'links', []))}")

            # Prevent duplicate node creation
            try:
                existing = self.net.get(node_id)
                if existing is not None:
                    logger.info(f"Node {node_id} already exists; skipping creation")
                    return {'success': True, 'info': 'node_exists'}
            except Exception as e:
                logger.debug(f"Error checking existing node {node_id}: {e}")
                existing = None

            # Add node based on type
            if node_type == 'host':
                params = {}
                if 'ip' in kwargs and kwargs['ip'] and kwargs['ip'] != 'auto':
                    params['ip'] = kwargs['ip']
                if 'mac' in kwargs and kwargs['mac'] and kwargs['mac'] != 'auto' and self._is_valid_mac(kwargs['mac']):
                    params['mac'] = kwargs['mac']
                try:
                    # Check if addHost method exists
                    if hasattr(self.net, 'addHost'):
                        host = self.net.addHost(node_id, **params)
                        logger.info(f"Successfully added host {node_id}")
                    else:
                        logger.warning(f"addHost method not available on network object")
                        # Try alternative approach - add to hosts collection directly
                        try:
                            from mininet.node import Host
                            host = Host(node_id, **params)
                            self.net.hosts.append(host)
                            logger.info(f"Added host {node_id} to hosts collection")
                        except Exception as e2:
                            logger.error(f"Could not add host {node_id} using alternative method: {e2}")
                            return {'success': False, 'error': 'Network does not support adding hosts'}
                except Exception as e:
                    logger.error(f"Failed to add host {node_id}: {e}")
                    return {'success': False, 'error': f'Failed to add host: {str(e)}'}
                    
            elif node_type == 'router':
                params = {}
                if 'ip' in kwargs and kwargs['ip'] and kwargs['ip'] != 'auto':
                    params['ip'] = kwargs['ip']
                try:
                    # Check if addHost method exists
                    if hasattr(self.net, 'addHost'):
                        router = self.net.addHost(node_id, cls=Router, **params)
                        logger.info(f"Successfully added router {node_id}")
                    else:
                        logger.warning(f"addHost method not available on network object")
                        # Try alternative approach - add to hosts collection directly
                        try:
                            router = Router(node_id, **params)
                            self.net.hosts.append(router)
                            logger.info(f"Added router {node_id} to hosts collection")
                        except Exception as e2:
                            logger.error(f"Could not add router {node_id} using alternative method: {e2}")
                            return {'success': False, 'error': 'Network does not support adding routers'}
                except Exception as e:
                    logger.error(f"Failed to add router {node_id}: {e}")
                    return {'success': False, 'error': f'Failed to add router: {str(e)}'}
                    
            elif node_type == 'switch':
                params = {}
                if 'dpid' in kwargs and kwargs['dpid'] and kwargs['dpid'] != 'auto' and self._is_valid_dpid(kwargs['dpid']):
                    params['dpid'] = kwargs['dpid']
                try:
                    # Check if addSwitch method exists
                    if hasattr(self.net, 'addSwitch'):
                        sw = self.net.addSwitch(node_id, **params)
                        self._maybe_apply_controller_to_switch(sw)
                        logger.info(f"Successfully added switch {node_id}")
                    else:
                        logger.warning(f"addSwitch method not available on network object")
                        # Try alternative approach - add to switches collection directly
                        try:
                            from mininet.node import OVSSwitch
                            sw = OVSSwitch(node_id, **params)
                            self.net.switches.append(sw)
                            logger.info(f"Added switch {node_id} to switches collection")
                        except Exception as e2:
                            logger.error(f"Could not add switch {node_id} using alternative method: {e2}")
                            return {'success': False, 'error': 'Network does not support adding switches'}
                except Exception as e:
                    logger.error(f"Failed to add switch {node_id}: {e}")
                    return {'success': False, 'error': f'Failed to add switch: {str(e)}'}
                    
            elif node_type == 'controller':
                # Controllers are external entities, not part of the Mininet network
                # They're tracked in metadata but not added to the network
                logger.info(f"Controller {node_id} registered (external entity)")
                # Don't add to network, just track in metadata
            else:
                return {'success': False, 'error': f'Unsupported node type {node_type}'}
                
            # If we get here, the node was added successfully or is a controller
            # For controllers, we still want to track them in the config
            if node_type != 'controller':
                # Verify the node was actually added
                try:
                    added_node = self.net.get(node_id)
                    if not added_node:
                        logger.warning(f"Node {node_id} was not found after addition")
                        return {'success': False, 'error': 'Node addition failed verification'}
                except Exception as e:
                    logger.warning(f"Could not verify node {node_id} after addition: {e}")
                    # Continue anyway, the node might be there

            # Track position metadata if provided
            if not hasattr(self, 'node_positions'):
                self.node_positions = {}
            if 'x' in kwargs and 'y' in kwargs:
                self.node_positions[node_id] = {'x': kwargs['x'], 'y': kwargs['y']}

            # Update original config store
            if not hasattr(self, 'original_topology_config'):
                self.original_topology_config = {'nodes': [], 'links': []}
            self.original_topology_config.setdefault('nodes', []).append({
                'id': node_id,
                'type': node_type,
                **({k: kwargs[k] for k in ['ip','mac','dpid','openflow_version','port'] if k in kwargs})
            })

            # Start the added node if network is running
            if self.is_running:
                # For switches/hosts Mininet handles runtime additions; link add triggers will attach
                pass

            # Refresh topology data
            try:
                self.update_topology_data()
            except Exception as e:
                logger.warning(f"Error updating topology data after adding node {node_id}: {e}")
                # Don't fail the operation if topology update fails
                
            logger.info(f"Successfully completed adding node {node_id}")
            return {'success': True}
        except Exception as e:
            logger.error(f"Error adding node {node_id}: {e}")
            return {'success': False, 'error': str(e)}
        """

    def remove_node(self, node_id):
        """Remove a node and related links from running topology."""
        # Delegate to topology manager
        success = self.topology_manager.remove_node(self.net, node_id)
        return {'success': success}

        # Legacy implementation (commented out)
        """
        ok, err = self._ensure_net_running()
        if not ok:
            return {'success': False, 'error': err}
        try:
            # Check if network exists
            if not self.net:
                return {'success': False, 'error': 'Network not initialized'}
                
            # Debug network object state
            logger.info(f"Network object type: {type(self.net).__name__}")
            logger.info(f"Network running: {getattr(self.net, 'running', 'unknown')}")
            logger.info(f"Network hosts: {len(getattr(self.net, 'hosts', []))}")
            logger.info(f"Network switches: {len(getattr(self.net, 'switches', []))}")
            logger.info(f"Network links: {len(getattr(self.net, 'links', []))}")
                
            logger.info(f"Attempting to get node {node_id}")
            logger.info(f"Node ID type: {type(node_id)}")
            logger.info(f"Node ID value: {repr(node_id)}")
            logger.info(f"Node ID is None: {node_id is None}")
            
            if node_id is None:
                logger.error("Node ID is None - cannot proceed with removal")
                return {'success': False, 'error': 'Node ID is None'}
            
            # Use safer methods to find the node instead of self.net.get()
            node = None
            try:
                # First try to find in hosts
                if hasattr(self.net, 'hosts'):
                    for host in self.net.hosts:
                        if hasattr(host, 'name') and host.name == node_id:
                            node = host
                            logger.info(f"Found node {node_id} in hosts collection")
                            break
                
                # If not found in hosts, try switches
                if not node and hasattr(self.net, 'switches'):
                    for switch in self.net.switches:
                        if hasattr(switch, 'name') and switch.name == node_id:
                            node = switch
                            logger.info(f"Found node {node_id} in switches collection")
                            break
                
                # If still not found, try the get method as fallback
                if not node:
                    logger.info(f"Trying fallback get method for {node_id}")
                    node = self.net.get(node_id, None)
                    
            except Exception as e:
                logger.warning(f"Error using get method: {e}")
                node = None
            
            if not node:
                logger.error(f"Node {node_id} not found in network")
                return {'success': False, 'error': f'Node {node_id} not found'}

            logger.info(f"Found node {node_id} of type {type(node).__name__}")
            logger.info(f"Node name: {getattr(node, 'name', 'unknown')}")
            logger.info(f"Node interfaces: {len(getattr(node, 'intfs', [])) if hasattr(node, 'intfs') else 'unknown'}")

            # Detach and delete all links involving the node
            logger.info(f"Starting link removal process for node {node_id}")
            links_to_remove = []
            try:
                if hasattr(self.net, 'links') and self.net.links:
                    logger.info(f"Network has {len(self.net.links)} links")
                    links_to_remove = [l for l in list(self.net.links) 
                                    if hasattr(l, 'intf1') and hasattr(l, 'intf2') 
                                    and l.intf1 and l.intf2 
                                    and (l.intf1.node == node or l.intf2.node == node)]
                    logger.info(f"Found {len(links_to_remove)} links to remove for node {node_id}")
                else:
                    logger.info(f"No links found for node {node_id}")
            except Exception as e:
                logger.warning(f"Error getting links for node {node_id}: {e}")
                logger.warning(f"Error type: {type(e).__name__}")
                links_to_remove = []
                
            # Remove links safely
            for l in links_to_remove:
                try:
                    # Validate link and interfaces before processing
                    if not l:
                        logger.warning(f"Skipping None link object")
                        continue
                        
                    if not hasattr(l, 'intf1') or not hasattr(l, 'intf2'):
                        logger.warning(f"Link {l} missing intf1 or intf2 attributes")
                        continue
                        
                    if not l.intf1 or not l.intf2:
                        logger.warning(f"Link {l} has None interfaces")
                        continue
                        
                    if not hasattr(l.intf1, 'node') or not hasattr(l.intf2, 'node'):
                        logger.warning(f"Link interfaces missing node attribute")
                        continue
                        
                    if not l.intf1.node or not l.intf2.node:
                        logger.warning(f"Link interfaces have None nodes")
                        continue
                    
                    # Now safely remove the link
                    if hasattr(self.net, 'delLinkBetween'):
                        try:
                            self.net.delLinkBetween(l.intf1.node, l.intf2.node)
                            logger.info(f"Removed link between {l.intf1.node.name if hasattr(l.intf1.node, 'name') else 'unknown'} and {l.intf2.node.name if hasattr(l.intf2.node, 'name') else 'unknown'}")
                        except Exception as e2:
                            logger.warning(f"delLinkBetween failed: {e2}, trying fallback")
                            # Fallback: try to remove the link object directly
                            if l in self.net.links:
                                self.net.links.remove(l)
                                logger.info(f"Removed link using fallback method")
                    else:
                        # Fallback: try to remove the link object directly
                        try:
                            if l in self.net.links:
                                self.net.links.remove(l)
                                logger.info(f"Removed link using fallback method")
                        except Exception as e2:
                            logger.warning(f"Could not remove link using fallback: {e2}")
                            
                except Exception as e:
                    logger.warning(f"Error removing link for node {node_id}: {e}")
                    logger.warning(f"Link object: {l}")
                    logger.warning(f"Link type: {type(l)}")

            # Remove node safely
            try:
                if hasattr(node, 'intfList') and node.intfList():
                    for intf in node.intfList():
                        try:
                            if intf:
                                # Use the correct Mininet method to remove interfaces
                                if hasattr(self.net, 'removeLink'):
                                    self.net.removeLink(intf)
                                else:
                                    # Fallback: try to remove from links collection
                                    try:
                                        if intf in self.net.links:
                                            self.net.links.remove(intf)
                                    except Exception as e2:
                                        logger.debug(f"Could not remove interface from links: {e2}")
                        except Exception as e:
                            logger.debug(f"Error removing interface {intf}: {e}")
                            pass
            except Exception as e:
                logger.debug(f"Error processing interfaces for node {node_id}: {e}")
                pass
                
            # Remove node from appropriate collection
            logger.info(f"Starting node removal process for {node_id}")
            try:
                if hasattr(self.net, 'hosts') and node in self.net.hosts:
                    logger.info(f"Node {node_id} found in hosts collection")
                    # Use the correct Mininet method to remove hosts
                    if hasattr(self.net, 'removeHost'):
                        logger.info(f"Using removeHost method for {node_id}")
                        self.net.removeHost(node)
                        logger.info(f"Removed host {node_id}")
                    else:
                        logger.info(f"removeHost method not available, using fallback for {node_id}")
                        # Fallback: try to remove from hosts collection
                        try:
                            self.net.hosts.remove(node)
                            logger.info(f"Removed host {node_id} from collection")
                        except Exception as e2:
                            logger.warning(f"Could not remove host from collection: {e2}")
                            logger.warning(f"Error type: {type(e2).__name__}")
                elif hasattr(self.net, 'switches') and node in self.net.switches:
                    logger.info(f"Node {node_id} found in switches collection")
                    # Use the correct Mininet method to remove switches
                    if hasattr(self.net, 'removeSwitch'):
                        logger.info(f"Using removeSwitch method for {node_id}")
                        self.net.removeSwitch(node)
                        logger.info(f"Removed switch {node_id}")
                    else:
                        logger.info(f"removeSwitch method not available, using fallback for {node_id}")
                        # Fallback: try to remove from switches collection
                        try:
                            self.net.switches.remove(node)
                            logger.info(f"Removed switch {node_id} from collection")
                        except Exception as e2:
                            logger.warning(f"Could not remove switch from collection: {e2}")
                            logger.warning(f"Error type: {type(e2).__name__}")
                else:
                    logger.warning(f"Node {node_id} not found in hosts or switches collections")
                    logger.warning(f"Available hosts: {[h.name for h in self.net.hosts] if hasattr(self.net, 'hosts') else 'unknown'}")
                    logger.warning(f"Available switches: {[s.name for s in self.net.switches] if hasattr(self.net, 'switches') else 'unknown'}")
            except Exception as e:
                logger.warning(f"Error removing node {node_id} from network: {e}")
                logger.warning(f"Error type: {type(e).__name__}")

            # Update local config stores
            if hasattr(self, 'node_positions') and node_id in self.node_positions:
                self.node_positions.pop(node_id, None)
            if hasattr(self, 'original_topology_config'):
                self.original_topology_config['nodes'] = [n for n in self.original_topology_config.get('nodes', []) if n.get('id') != node_id]
                self.original_topology_config['links'] = [l for l in self.original_topology_config.get('links', []) if l.get('source') != node_id and l.get('target') != node_id]

            # Verify the node was actually removed
            logger.info(f"Verifying node removal for {node_id}")
            try:
                remaining_node = self.net.get(node_id, None)
                if remaining_node:
                    logger.warning(f"Node {node_id} still exists after removal attempt")
                    logger.warning(f"Remaining node type: {type(remaining_node).__name__}")
                    # Don't fail, just warn
                else:
                    logger.info(f"Node {node_id} successfully removed from network")
            except Exception as e:
                logger.debug(f"Could not verify node removal: {e}")
                logger.debug(f"Error type: {type(e).__name__}")

            # Update topology data
            logger.info(f"Updating topology data after removing {node_id}")
            try:
                self.update_topology_data()
                logger.info(f"Topology data updated successfully")
            except Exception as e:
                logger.warning(f"Error updating topology data after removing node {node_id}: {e}")
                logger.warning(f"Error type: {type(e).__name__}")
                # Don't fail the operation if topology update fails
                
            logger.info(f"Successfully completed node removal process for {node_id}")
            return {'success': True}
        except Exception as e:
            logger.error(f"Error removing node {node_id}: {e}")
            logger.error(f"Error type: {type(e).__name__}")
            logger.error(f"Error details: {str(e)}")
            import traceback
            logger.error(f"Traceback: {traceback.format_exc()}")
            return {'success': False, 'error': str(e)}
        """

    def add_link(self, source_id, target_id, **kwargs):
        """Add a link between two nodes while running."""
        # Delegate to topology manager
        success = self.topology_manager.add_link(self.net, source_id, target_id, **kwargs)
        return {'success': success}

        # Legacy implementation (commented out)
        """
        ok, err = self._ensure_net_running()
        if not ok:
            return {'success': False, 'error': err}
        try:
            # Check if network exists and is properly initialized
            if not self.net:
                return {'success': False, 'error': 'Network not initialized'}
                
            # Debug network object state
            logger.info(f"Adding link between {source_id} and {target_id}")
            logger.info(f"Network object type: {type(self.net).__name__}")
            logger.info(f"Network running: {getattr(self.net, 'running', 'unknown')}")
            logger.info(f"Network hosts: {len(getattr(self.net, 'hosts', []))}")
            logger.info(f"Network switches: {len(getattr(self.net, 'switches', []))}")
            logger.info(f"Network links: {len(getattr(self.net, 'links', []))}")
                
            try:
                n1 = self.net.get(source_id)
            except Exception as e:
                logger.error(f"Error getting source node {source_id}: {e}")
                n1 = None
            try:
                n2 = self.net.get(target_id)
            except Exception as e:
                logger.error(f"Error getting target node {target_id}: {e}")
                n2 = None
            if n1 is None or n2 is None:
                return {'success': False, 'error': 'Source or target not found'}

            # Prevent duplicate link creation
            for l in list(self.net.links):
                try:
                    if (l.intf1.node == n1 and l.intf2.node == n2) or (l.intf1.node == n2 and l.intf2.node == n1):
                        logger.info(f"Link {source_id}-{target_id} already exists; skipping creation")
                        return {'success': True, 'info': 'link_exists'}
                except Exception:
                    continue
                    
            # Special handling for controller links
            # Controllers are external entities, so we just track the connection
            if source_id.startswith('c') or target_id.startswith('c'):
                logger.info(f"Controller link {source_id}-{target_id} registered (external connection)")
                # Store in config but don't create physical link
                if not hasattr(self, 'original_topology_config'):
                    self.original_topology_config = {'nodes': [], 'links': []}
                self.original_topology_config.setdefault('links', []).append({
                    'source': source_id,
                    'target': target_id,
                    **({k: kwargs[k] for k in ['bandwidth','delay','loss'] if k in kwargs})
                })
                self.update_topology_data()
                return {'success': True, 'info': 'controller_link_registered'}

            params = {}
            if 'bandwidth' in kwargs and kwargs['bandwidth']:
                try:
                    bw = self._parse_bandwidth(kwargs['bandwidth'])
                    params['bw'] = bw
                except Exception:
                    pass
            if 'delay' in kwargs and kwargs['delay']:
                params['delay'] = kwargs['delay']
            if 'loss' in kwargs and kwargs['loss'] is not None:
                params['loss'] = kwargs['loss']

            # Add link
            try:
                # Check if addLink method exists
                if hasattr(self.net, 'addLink'):
                    if params:
                        self.net.addLink(n1, n2, cls=TCLink, **params)
                    else:
                        self.net.addLink(n1, n2)
                    logger.info(f"Successfully added link between {source_id} and {target_id}")
                else:
                    logger.warning(f"addLink method not available on network object")
                    # Try alternative approach - create link object and add to links collection
                    try:
                        if params:
                            link = TCLink(n1, n2, **params)
                        else:
                            link = TCLink(n1, n2)
                        self.net.links.append(link)
                        logger.info(f"Added link between {source_id} and {target_id} to links collection")
                    except Exception as e2:
                        logger.error(f"Could not add link using alternative method: {e2}")
                        return {'success': False, 'error': 'Network does not support adding links'}
            except Exception as e:
                logger.error(f"Failed to add link between {source_id} and {target_id}: {e}")
                return {'success': False, 'error': f'Failed to add link: {str(e)}'}

            # Store in original config
            if not hasattr(self, 'original_topology_config'):
                self.original_topology_config = {'nodes': [], 'links': []}
            self.original_topology_config.setdefault('links', []).append({
                'source': source_id,
                'target': target_id,
                **({k: kwargs[k] for k in ['bandwidth','delay','loss'] if k in kwargs})
            })
            
            # Verify the link was actually added (for non-controller links)
            if not (source_id.startswith('c') or target_id.startswith('c')):
                try:
                    # Check if the link exists in the network
                    link_found = False
                    if hasattr(self.net, 'links'):
                        for l in self.net.links:
                            try:
                                if (l.intf1.node.name == source_id and l.intf2.node.name == target_id) or \
                                   (l.intf1.node.name == target_id and l.intf2.node.name == source_id):
                                    link_found = True
                                    break
                            except Exception:
                                continue
                        if not link_found:
                            logger.warning(f"Link {source_id}-{target_id} was not found after addition")
                            # Continue anyway, the link might be there
                except Exception as e:
                    logger.debug(f"Could not verify link {source_id}-{target_id} after addition: {e}")
                    # Continue anyway

            # Update topology data
            try:
                self.update_topology_data()
            except Exception as e:
                logger.warning(f"Error updating topology data after adding link {source_id}-{target_id}: {e}")
                # Don't fail the operation if topology update fails
                
            logger.info(f"Successfully completed adding link {source_id}-{target_id}")
            return {'success': True}
        except Exception as e:
            logger.error(f"Error adding link {source_id}-{target_id}: {e}")
            return {'success': False, 'error': str(e)}
        """

    def remove_link(self, source_id, target_id):
        """Remove link between given nodes."""
        # Delegate to topology manager
        success = self.topology_manager.remove_link(self.net, source_id, target_id)
        return {'success': success}

        # Legacy implementation (commented out)
        """
        ok, err = self._ensure_net_running()
        if not ok:
            return {'success': False, 'error': err}
        try:
            # Check if network exists
            if not self.net:
                return {'success': False, 'error': 'Network not initialized'}
                
            # Debug network object state
            logger.info(f"Network object type: {type(self.net).__name__}")
            logger.info(f"Network running: {getattr(self.net, 'running', 'unknown')}")
            logger.info(f"Network hosts: {len(getattr(self.net, 'hosts', []))}")
            logger.info(f"Network switches: {len(getattr(self.net, 'switches', []))}")
            logger.info(f"Network links: {len(getattr(self.net, 'links', []))}")
            
            # Use safer methods to find nodes instead of self.net.get()
            n1 = None
            n2 = None
            
            # Find source node
            try:
                if hasattr(self.net, 'hosts'):
                    for host in self.net.hosts:
                        if hasattr(host, 'name') and host.name == source_id:
                            n1 = host
                            logger.info(f"Found source node {source_id} in hosts collection")
                            break
                
                if not n1 and hasattr(self.net, 'switches'):
                    for switch in self.net.switches:
                        if hasattr(switch, 'name') and switch.name == source_id:
                            n1 = switch
                            logger.info(f"Found source node {source_id} in switches collection")
                            break
                            
            except Exception as e:
                logger.warning(f"Error finding source node {source_id}: {e}")
            
            # Find target node
            try:
                if hasattr(self.net, 'hosts'):
                    for host in self.net.hosts:
                        if hasattr(host, 'name') and host.name == target_id:
                            n2 = host
                            logger.info(f"Found target node {target_id} in hosts collection")
                            break
                
                if not n2 and hasattr(self.net, 'switches'):
                    for switch in self.net.switches:
                        if hasattr(switch, 'name') and switch.name == target_id:
                            n2 = switch
                            logger.info(f"Found target node {target_id} in switches collection")
                            break
                            
            except Exception as e:
                logger.warning(f"Error finding target node {target_id}: {e}")
                
            if not n1 or not n2:
                logger.error(f"Source node {source_id} or target node {target_id} not found")
                return {'success': False, 'error': f'Source node {source_id} or target node {target_id} not found'}

            logger.info(f"Removing link between {source_id} and {target_id}")

            # Try to remove the link safely
            try:
                if hasattr(self.net, 'delLinkBetween'):
                    self.net.delLinkBetween(n1, n2)
                    logger.info(f"Successfully removed link {source_id}-{target_id} using delLinkBetween")
                else:
                    # Fallback: find and remove the link object directly
                    link_to_remove = None
                    for link in list(self.net.links):
                        try:
                            if (hasattr(link, 'intf1') and hasattr(link, 'intf2') and 
                                link.intf1 and link.intf2 and 
                                hasattr(link.intf1, 'node') and hasattr(link.intf2, 'node') and
                                link.intf1.node and link.intf2.node):
                                
                                if ((link.intf1.node == n1 and link.intf2.node == n2) or 
                                    (link.intf1.node == n2 and link.intf2.node == n1)):
                                    link_to_remove = link
                                    break
                        except Exception as e:
                            logger.debug(f"Error checking link {link}: {e}")
                            continue
                    
                    if link_to_remove:
                        self.net.links.remove(link_to_remove)
                        logger.info(f"Successfully removed link {source_id}-{target_id} using fallback method")
                    else:
                        logger.warning(f"Link {source_id}-{target_id} not found in network links")
                        
            except Exception as e:
                logger.warning(f"Error removing link {source_id}-{target_id}: {e}")
                # Continue with cleanup even if link removal fails

            # Update local config stores
            if hasattr(self, 'original_topology_config'):
                self.original_topology_config['links'] = [l for l in self.original_topology_config.get('links', []) if not ((l.get('source') == source_id and l.get('target') == target_id) or (l.get('source') == target_id and l.get('target') == source_id))]

            # Update topology data
            try:
                self.update_topology_data()
            except Exception as e:
                logger.warning(f"Error updating topology data after removing link {source_id}-{target_id}: {e}")
                # Don't fail the operation if topology update fails
                
            return {'success': True}
        except Exception as e:
            logger.error(f"Error removing link {source_id}-{target_id}: {e}")
            logger.error(f"Exception type: {type(e).__name__}")
            logger.error(f"Exception details: {str(e)}")
            import traceback
            logger.error(f"Full traceback: {traceback.format_exc()}")
            return {'success': False, 'error': str(e)}
        """

    def get_network_metrics(self):
        """Get real-time network metrics"""
        # Delegate to network monitor
        return self.network_monitor.get_network_metrics(self.net)
    
    def execute_host_command(self, host_id, command):
        """Execute command on a specific host"""
        if not self.net or not self.is_running:
            return {'error': 'Network not running', 'success': False}
        
        host = self.net.get(host_id)
        if not host:
            return {'error': f'Host {host_id} not found', 'success': False}
        
        try:
            result = host.cmd(command)
            logger.info(f"Executed command '{command}' on {host_id}")
            return {'result': result.strip(), 'success': True}
        except Exception as e:
            logger.error(f"Command execution failed on {host_id}: {e}")
            return {'error': str(e), 'success': False}
    
    def start_cli(self):
        """Start Mininet CLI"""
        if self.net:
            logger.info("Starting CLI")
            CLI(self.net)
    def diagnose_connectivity_issues(self):
        """
        Diagnose connectivity issues in the network
        Returns detailed analysis of network connectivity problems
        """
        # Delegate to network monitor
        return self.network_monitor.diagnose_connectivity_issues(self.net)

        # Legacy implementation (commented out)
        """
        if not self.net or not self.is_running:
            return {
                'status': 'error',
                'message': 'Network not running',
                'issues': ['Network is not started'],
                'recommendations': ['Start the network first']
            }
        
        try:
            issues = []
            recommendations = []
            detailed_results = {}
            
            # 1. Check controller connectivity
            controller_issues = self._check_controller_connectivity()
            if controller_issues['issues']:
                issues.extend(controller_issues['issues'])
                recommendations.extend(controller_issues['recommendations'])
            detailed_results['controller'] = controller_issues
            
            # 2. Check switch connectivity to controller
            switch_controller_issues = self._check_switch_controller_connectivity()
            if switch_controller_issues['issues']:
                issues.extend(switch_controller_issues['issues'])
                recommendations.extend(switch_controller_issues['recommendations'])
            detailed_results['switch_controller'] = switch_controller_issues
            
            # 3. Check host-to-host connectivity
            host_connectivity_issues = self._check_host_connectivity()
            if host_connectivity_issues['issues']:
                issues.extend(host_connectivity_issues['issues'])
                recommendations.extend(host_connectivity_issues['recommendations'])
            detailed_results['host_connectivity'] = host_connectivity_issues
            
            # 4. Check interface status
            interface_issues = self._check_interface_status()
            if interface_issues['issues']:
                issues.extend(interface_issues['issues'])
                recommendations.extend(interface_issues['recommendations'])
            detailed_results['interfaces'] = interface_issues
            
            # 5. Check flow table status
            flow_issues = self._check_flow_tables()
            if flow_issues['issues']:
                issues.extend(flow_issues['issues'])
                recommendations.extend(flow_issues['recommendations'])
            detailed_results['flows'] = flow_issues
            
            # 6. Check ARP tables
            arp_issues = self._check_arp_tables()
            if arp_issues['issues']:
                issues.extend(arp_issues['issues'])
                recommendations.extend(arp_issues['recommendations'])
            detailed_results['arp'] = arp_issues
            
            # 7. Check routing (for routers)
            routing_issues = self._check_routing_tables()
            if routing_issues['issues']:
                issues.extend(routing_issues['issues'])
                recommendations.extend(routing_issues['recommendations'])
            detailed_results['routing'] = routing_issues
            
            # Overall status
            status = 'healthy' if not issues else 'issues_found'
            
            return {
                'status': status,
                'message': f'Found {len(issues)} connectivity issues' if issues else 'No connectivity issues detected',
                'issues': issues,
                'recommendations': recommendations,
                'detailed_results': detailed_results,
                'timestamp': datetime.now().isoformat()
            }
            
        except Exception as e:
            self.logger.error(f"Error during connectivity diagnosis: {e}")
            return {
                'status': 'error',
                'message': f'Diagnosis failed: {str(e)}',
                'issues': [f'Diagnostic error: {str(e)}'],
                'recommendations': ['Check system logs for more details']
            }

    def _check_controller_connectivity(self):
        """Check if controller is running and accessible"""
        issues = []
        recommendations = []
        details = {}
        
        try:
            # Check if controller is running
            active_controller = self.controller_factory.get_active_controller()
            if not active_controller:
                issues.append("No controller is active")
                recommendations.append("Start a controller")
                details['controller_running'] = False
            else:
                controller_info = self.controller_factory.get_controller_info().get(active_controller, {})
                if not controller_info.get('running', False):
                    issues.append(f"{active_controller.upper()} controller is not running")
                    recommendations.append(f"Start the {active_controller} controller")
                    details['controller_running'] = False
                else:
                    details['controller_running'] = True
                
            # Check controller process
            controller_status = self.get_controller_status()
            details['controller_status'] = controller_status
            
            if controller_status.get('running', False) and active_controller:
                # Check if controller port is accessible
                import socket
                try:
                    controller_info = self.controller_factory.get_controller_info().get(active_controller, {})
                    controller_port = controller_info.get('port', 6633)

                    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                    sock.settimeout(2)
                    result = sock.connect_ex(('127.0.0.1', controller_port))
                    sock.close()

                    if result != 0:
                        issues.append(f"Controller port {controller_port} is not accessible")
                        recommendations.append("Check if controller is listening on the correct port")
                        details['port_accessible'] = False
                    else:
                        details['port_accessible'] = True
                        
                except Exception as e:
                    issues.append(f"Cannot check controller port accessibility: {e}")
                    details['port_check_error'] = str(e)
            
        except Exception as e:
            issues.append(f"Controller connectivity check failed: {e}")
            
        return {
            'issues': issues,
            'recommendations': recommendations,
            'details': details
        }
        """

    def _check_switch_controller_connectivity(self):
        """Check if switches are connected to controller"""
        issues = []
        recommendations = []
        details = {}
        
        try:
            switches = [s for s in self.net.switches]
            details['switches_checked'] = len(switches)
            details['switch_details'] = {}
            
            for switch in switches:
                switch_details = {}
                
                try:
                    # Check if switch is connected to controller using ovs-vsctl
                    result = subprocess.run(
                        ['ovs-vsctl', 'get-controller', switch.name],
                        capture_output=True, text=True, timeout=5
                    )
                    
                    if result.returncode == 0:
                        controller_info = result.stdout.strip()
                        switch_details['controller_configured'] = controller_info
                        
                        if 'tcp:' not in controller_info:
                            issues.append(f"Switch {switch.name} has no controller configured")
                            recommendations.append(f"Configure controller for switch {switch.name}")
                    else:
                        issues.append(f"Cannot get controller info for switch {switch.name}")
                        switch_details['controller_configured'] = 'unknown'
                    
                    # Check OpenFlow connection status
                    result = subprocess.run(
                        ['ovs-vsctl', 'show'],
                        capture_output=True, text=True, timeout=5
                    )
                    
                    if result.returncode == 0:
                        ovs_output = result.stdout
                        if switch.name in ovs_output:
                            if 'is_connected: true' in ovs_output:
                                switch_details['connected'] = True
                            else:
                                switch_details['connected'] = False
                                issues.append(f"Switch {switch.name} is not connected to controller")
                                recommendations.append(f"Check OpenFlow connection for {switch.name}")
                    
                except subprocess.TimeoutExpired:
                    issues.append(f"Timeout checking switch {switch.name}")
                    switch_details['timeout'] = True
                except Exception as e:
                    issues.append(f"Error checking switch {switch.name}: {e}")
                    switch_details['error'] = str(e)
                    
                details['switch_details'][switch.name] = switch_details
                
        except Exception as e:
            issues.append(f"Switch-controller connectivity check failed: {e}")
            
        return {
            'issues': issues,
            'recommendations': recommendations,
            'details': details
        }

    def _check_host_connectivity(self):
        """Check host-to-host connectivity"""
        issues = []
        recommendations = []
        details = {}
        
        try:
            hosts = [h for h in self.net.hosts if not isinstance(h, Router)]
            details['hosts_checked'] = len(hosts)
            details['ping_results'] = {}
            
            if len(hosts) < 2:
                details['note'] = 'Less than 2 hosts available for connectivity testing'
                return {
                    'issues': issues,
                    'recommendations': recommendations,
                    'details': details
                }
            
            # Test connectivity between all pairs of hosts
            failed_pairs = []
            total_tests = 0
            
            for i, host1 in enumerate(hosts):
                for host2 in hosts[i+1:]:
                    total_tests += 1
                    try:
                        # Ping from host1 to host2
                        result = host1.cmd(f'ping -c 1 -W 2 {host2.IP()}')
                        
                        if '1 packets transmitted, 1 received' in result:
                            details['ping_results'][f'{host1.name}->{host2.name}'] = 'success'
                        else:
                            details['ping_results'][f'{host1.name}->{host2.name}'] = 'failed'
                            failed_pairs.append((host1.name, host2.name))
                            
                    except Exception as e:
                        details['ping_results'][f'{host1.name}->{host2.name}'] = f'error: {e}'
                        failed_pairs.append((host1.name, host2.name))
            
            details['total_tests'] = total_tests
            details['failed_tests'] = len(failed_pairs)
            
            if failed_pairs:
                issues.append(f"Connectivity failed between {len(failed_pairs)} host pairs")
                recommendations.append("Check switch flow tables and ARP resolution")
                for pair in failed_pairs:
                    issues.append(f"No connectivity: {pair[0]} -> {pair[1]}")
                    
        except Exception as e:
            issues.append(f"Host connectivity check failed: {e}")
            
        return {
            'issues': issues,
            'recommendations': recommendations,
            'details': details
        }

    def _check_interface_status(self):
        """Check interface status for all nodes"""
        issues = []
        recommendations = []
        details = {}
        
        try:
            all_nodes = self.net.hosts + self.net.switches
            details['interfaces'] = {}
            
            for node in all_nodes:
                node_interfaces = {}
                
                try:
                    for intf in node.intfList():
                        if intf.name == 'lo':
                            continue
                            
                        intf_info = {
                            'name': intf.name,
                            'up': intf.isUp(),
                            'ip': getattr(intf, 'ip', 'N/A'),
                            'mac': getattr(intf, 'mac', 'N/A')
                        }
                        
                        if not intf.isUp():
                            issues.append(f"Interface {intf.name} on {node.name} is down")
                            recommendations.append(f"Bring up interface {intf.name} on {node.name}")
                            
                        node_interfaces[intf.name] = intf_info
                        
                except Exception as e:
                    node_interfaces['error'] = str(e)
                    issues.append(f"Cannot check interfaces on {node.name}: {e}")
                    
                details['interfaces'][node.name] = node_interfaces
                
        except Exception as e:
            issues.append(f"Interface status check failed: {e}")
            
        return {
            'issues': issues,
            'recommendations': recommendations,
            'details': details
        }

    def _check_flow_tables(self):
        """Check OpenFlow flow tables on switches"""
        issues = []
        recommendations = []
        details = {}
        
        try:
            switches = [s for s in self.net.switches]
            details['flow_tables'] = {}
            
            for switch in switches:
                switch_flows = {}
                
                try:
                    # Get flow table using ovs-ofctl
                    result = subprocess.run(
                        ['ovs-ofctl', 'dump-flows', switch.name, '-O', 'OpenFlow13'],
                        capture_output=True, text=True, timeout=5
                    )
                    
                    if result.returncode == 0:
                        flow_lines = result.stdout.strip().split('\n')[1:]  # Skip header
                        switch_flows['flow_count'] = len(flow_lines)
                        switch_flows['flows'] = flow_lines[:5]  # First 5 flows
                        
                        if len(flow_lines) == 0:
                            issues.append(f"No flows installed on switch {switch.name}")
                            recommendations.append(f"Check controller application and host connectivity")
                        elif len(flow_lines) < 2:
                            issues.append(f"Very few flows on switch {switch.name} (only {len(flow_lines)})")
                            recommendations.append(f"Generate some traffic to populate flow tables")
                            
                    else:
                        switch_flows['error'] = 'Cannot dump flows'
                        issues.append(f"Cannot dump flows from switch {switch.name}")
                        
                except subprocess.TimeoutExpired:
                    switch_flows['error'] = 'timeout'
                    issues.append(f"Timeout dumping flows from switch {switch.name}")
                except Exception as e:
                    switch_flows['error'] = str(e)
                    issues.append(f"Error checking flows on switch {switch.name}: {e}")
                    
                details['flow_tables'][switch.name] = switch_flows
                
        except Exception as e:
            issues.append(f"Flow table check failed: {e}")
            
        return {
            'issues': issues,
            'recommendations': recommendations,
            'details': details
        }

    def _check_arp_tables(self):
        """Check ARP tables on hosts"""
        issues = []
        recommendations = []
        details = {}
        
        try:
            hosts = [h for h in self.net.hosts if not isinstance(h, Router)]
            details['arp_tables'] = {}
            
            for host in hosts:
                arp_info = {}
                
                try:
                    # Get ARP table
                    result = host.cmd('arp -a')
                    arp_info['arp_output'] = result.strip()
                    
                    # Count ARP entries
                    arp_lines = [line for line in result.strip().split('\n') if line and '(' in line]
                    arp_info['arp_entries'] = len(arp_lines)
                    
                    if len(arp_lines) == 0:
                        issues.append(f"Host {host.name} has empty ARP table")
                        recommendations.append(f"Generate traffic from {host.name} to populate ARP table")
                        
                except Exception as e:
                    arp_info['error'] = str(e)
                    issues.append(f"Cannot check ARP table on {host.name}: {e}")
                    
                details['arp_tables'][host.name] = arp_info
                
        except Exception as e:
            issues.append(f"ARP table check failed: {e}")
            
        return {
            'issues': issues,
            'recommendations': recommendations,
            'details': details
        }

    def _check_routing_tables(self):
        """Check routing tables on routers"""
        issues = []
        recommendations = []
        details = {}
        
        try:
            routers = [r for r in self.net.hosts if isinstance(r, Router) or 
                    (hasattr(r, 'node_type') and r.node_type == 'router')]
            details['routers_checked'] = len(routers)
            details['routing_tables'] = {}
            
            for router in routers:
                routing_info = {}
                
                try:
                    # Get routing table
                    result = router.cmd('ip route show')
                    routing_info['routes'] = result.strip()
                    
                    # Count routes
                    route_lines = [line for line in result.strip().split('\n') if line]
                    routing_info['route_count'] = len(route_lines)
                    
                    # Check for default route
                    if 'default' not in result:
                        routing_info['has_default_route'] = False
                    else:
                        routing_info['has_default_route'] = True
                    
                    # Check IP forwarding
                    forwarding_result = router.cmd('cat /proc/sys/net/ipv4/ip_forward')
                    ip_forward_enabled = forwarding_result.strip() == '1'
                    routing_info['ip_forwarding'] = ip_forward_enabled
                    
                    if not ip_forward_enabled:
                        issues.append(f"IP forwarding disabled on router {router.name}")
                        recommendations.append(f"Enable IP forwarding on router {router.name}")
                    
                except Exception as e:
                    routing_info['error'] = str(e)
                    issues.append(f"Cannot check routing on {router.name}: {e}")
                    
                details['routing_tables'][router.name] = routing_info
                
        except Exception as e:
            issues.append(f"Routing table check failed: {e}")
            
        return {
            'issues': issues,
            'recommendations': recommendations,
            'details': details
        }

    def update_node_ip(self, node_id, new_ip, interface=None):
        """Update IP address of a node"""
        try:
            if not self.net:
                return {'success': False, 'error': 'Network not initialized'}
            
            # Find the node
            node = None
            if hasattr(self.net, 'hosts'):
                for host in self.net.hosts:
                    if hasattr(host, 'name') and host.name == node_id:
                        node = host
                        break
            
            if not node and hasattr(self.net, 'switches'):
                for switch in self.net.switches:
                    if hasattr(switch, 'name') and switch.name == node_id:
                        node = switch
                        break
            
            if not node:
                return {'success': False, 'error': f'Node {node_id} not found'}
            
            # Update IP address
            if interface:
                # Update specific interface
                if hasattr(node, 'intfs') and interface in node.intfs:
                    node.intfs[interface].setIP(new_ip)
                    logger.info(f"Updated IP of interface {interface} on {node_id} to {new_ip}")
                else:
                    return {'success': False, 'error': f'Interface {interface} not found on {node_id}'}
            else:
                # Update default interface
                if hasattr(node, 'defaultIntf') and node.defaultIntf():
                    node.defaultIntf().setIP(new_ip)
                    logger.info(f"Updated default IP of {node_id} to {new_ip}")
                else:
                    return {'success': False, 'error': f'No default interface found on {node_id}'}
            
            # Update topology data with a small delay to ensure Mininet reflects changes
            try:
                import time
                time.sleep(0.1)  # Small delay to ensure Mininet processes the change
                self.update_topology_data()
                logger.info(f"Topology data refreshed after IP update for {node_id}")
                
                # Verify the change was applied by checking the topology data
                updated_topology = self.get_topology_data()
                for node in updated_topology.get('nodes', []):
                    if node['id'] == node_id:
                        if node.get('ip') == new_ip:
                            logger.info(f"Verified IP update for {node_id}: {new_ip}")
                        else:
                            logger.warning(f"IP update verification failed for {node_id}: expected {new_ip}, got {node.get('ip')}")
                        break
                        
            except Exception as e:
                logger.warning(f"Error updating topology data after IP change: {e}")
            
            return {'success': True, 'message': f'IP updated to {new_ip}'}
            
        except Exception as e:
            logger.error(f"Error updating IP for {node_id}: {e}")
            return {'success': False, 'error': str(e)}

    def _parse_bandwidth(self, bandwidth_str):
        """Parse bandwidth string with units and convert to Mbps"""
        try:
            if isinstance(bandwidth_str, (int, float)):
                return int(bandwidth_str)
            
            bandwidth_str = str(bandwidth_str).strip().upper()
            
            # Remove any existing 'Mbit' or 'Gbit' suffix
            if bandwidth_str.endswith('MBIT') or bandwidth_str.endswith('M'):
                bandwidth_str = bandwidth_str.replace('MBIT', '').replace('M', '')
                multiplier = 1
            elif bandwidth_str.endswith('GBIT') or bandwidth_str.endswith('G'):
                bandwidth_str = bandwidth_str.replace('GBIT', '').replace('G', '')
                multiplier = 1000  # Convert Gbps to Mbps
            elif bandwidth_str.endswith('KBIT') or bandwidth_str.endswith('K'):
                bandwidth_str = bandwidth_str.replace('KBIT', '').replace('K', '')
                multiplier = 0.001  # Convert Kbps to Mbps
            else:
                # Assume Mbps if no unit specified
                multiplier = 1
            
            # Parse the numeric value
            numeric_value = float(bandwidth_str)
            bandwidth_mbps = int(numeric_value * multiplier)
            
            # Check Mininet's bandwidth limits
            if bandwidth_mbps > 1000:
                logger.warning(f"⚠️  Requested bandwidth {bandwidth_mbps} Mbps ({bandwidth_str}G) exceeds Mininet's limit of 1000 Mbps")
                logger.warning(f"   Mininet will ignore this value and keep the original bandwidth")
                logger.warning(f"   For high-bandwidth simulation, consider using multiple links or custom topology")
            
            return bandwidth_mbps
            
        except (ValueError, AttributeError) as e:
            logger.warning(f"Error parsing bandwidth '{bandwidth_str}': {e}")
            # Return default bandwidth of 100 Mbps
            return 100

    def update_link_bandwidth(self, source_id, target_id, new_bandwidth):
        """Update bandwidth of a link"""
        try:
            if not self.net:
                return {'success': False, 'error': 'Network not initialized'}
            
            # Validate node IDs
            if not source_id or not target_id:
                return {'success': False, 'error': 'Invalid node IDs provided'}
            
            # Log the request for debugging
            logger.info(f"Bandwidth update request: {source_id} -> {target_id} = {new_bandwidth}")
            
            # Parse and convert bandwidth to Mbps
            bandwidth_mbps = self._parse_bandwidth(new_bandwidth)
            logger.info(f"Parsed bandwidth '{new_bandwidth}' to {bandwidth_mbps} Mbps")
            
            # Find the link
            link_to_update = None
            for link in self.net.links:
                try:
                    if (hasattr(link, 'intf1') and hasattr(link, 'intf2') and 
                        link.intf1 and link.intf2 and 
                        hasattr(link.intf1, 'node') and hasattr(link.intf2, 'node') and
                        link.intf1.node and link.intf2.node):
                        
                        if ((link.intf1.node.name == source_id and link.intf2.node.name == target_id) or 
                            (link.intf1.node.name == target_id and link.intf2.node.name == source_id)):
                            link_to_update = link
                            break
                except Exception as e:
                    logger.debug(f"Error checking link {link}: {e}")
                    continue
            
            if not link_to_update:
                return {'success': False, 'error': f'Link {source_id}-{target_id} not found'}
            
            # Update bandwidth (this is limited in Mininet, but we can try)
            try:
                if hasattr(link_to_update, 'intf1') and link_to_update.intf1:
                    # Update interface bandwidth if possible
                    if hasattr(link_to_update.intf1, 'config'):
                        # Store original bandwidth for comparison
                        original_bw = None
                        try:
                            if hasattr(link_to_update.intf1, 'params') and 'bw' in link_to_update.intf1.params:
                                original_bw = link_to_update.intf1.params['bw']
                        except:
                            pass
                        
                        # Check if bandwidth is within Mininet's supported range
                        if bandwidth_mbps > 1000:
                            logger.warning(f"⚠️  Mininet limitation: Cannot set bandwidth {bandwidth_mbps} Mbps (>1000 Mbps)")
                            logger.warning(f"   The link will keep its current bandwidth of {original_bw} Mbps")
                            logger.warning(f"   For high-bandwidth simulation, consider using multiple links")
                            
                            # Try to set to maximum supported value
                            max_supported = 1000
                            link_to_update.intf1.config(bw=max_supported)
                            logger.info(f"Set bandwidth to maximum supported value: {max_supported} Mbps")
                            
                            # Update the bandwidth_mbps for the response
                            bandwidth_mbps = max_supported
                        else:
                            # Log interface details before update
                            logger.debug(f"Interface before update: {link_to_update.intf1}")
                            logger.debug(f"Interface params before: {getattr(link_to_update.intf1, 'params', 'No params')}")
                            
                            # Apply the bandwidth update
                            link_to_update.intf1.config(bw=bandwidth_mbps)
                            logger.info(f"Updated bandwidth of {source_id}-{target_id} from {original_bw}Mbps to {bandwidth_mbps} Mbps (parsed from '{new_bandwidth}')")
                            
                            # Log interface details after update
                            logger.debug(f"Interface after update: {link_to_update.intf1}")
                            logger.debug(f"Interface params after: {getattr(link_to_update.intf1, 'params', 'No params')}")
                        
                        # Verify the change was applied with multiple attempts
                        verification_success = False
                        max_attempts = 3
                        for attempt in range(max_attempts):
                            try:
                                # Try multiple ways to get the bandwidth value
                                new_bw = None
                                
                                # Method 1: Check params
                                if hasattr(link_to_update.intf1, 'params') and 'bw' in link_to_update.intf1.params:
                                    new_bw = link_to_update.intf1.params['bw']
                                    logger.debug(f"Attempt {attempt + 1}: Got bandwidth from params: {new_bw}")
                                
                                # Method 2: Check config attribute
                                elif hasattr(link_to_update.intf1, 'config') and hasattr(link_to_update.intf1.config, 'bw'):
                                    new_bw = link_to_update.intf1.config.bw
                                    logger.debug(f"Attempt {attempt + 1}: Got bandwidth from config: {new_bw}")
                                
                                # Method 3: Check bw attribute directly
                                elif hasattr(link_to_update.intf1, 'bw'):
                                    new_bw = link_to_update.intf1.bw
                                    logger.debug(f"Attempt {attempt + 1}: Got bandwidth from bw attribute: {new_bw}")
                                
                                if new_bw == bandwidth_mbps:
                                    logger.info(f"✅ Verified bandwidth update: {new_bw} Mbps")
                                    verification_success = True
                                    break
                                else:
                                    logger.debug(f"Attempt {attempt + 1}: Verification failed - expected {bandwidth_mbps}, got {new_bw}")
                                    
                                    # If this is the last attempt, log a warning
                                    if attempt == max_attempts - 1:
                                        logger.warning(f"⚠️  Bandwidth update verification failed after {max_attempts} attempts")
                                        logger.warning(f"   Expected: {bandwidth_mbps} Mbps, Got: {new_bw}")
                                        logger.warning(f"   This might be a Mininet timing issue - the change may still be applied")
                                    
                                    # Small delay before next attempt
                                    if attempt < max_attempts - 1:
                                        import time
                                        time.sleep(0.05)
                                        
                            except Exception as verify_e:
                                logger.debug(f"Attempt {attempt + 1}: Error during verification: {verify_e}")
                                if attempt == max_attempts - 1:
                                    logger.warning(f"Could not verify bandwidth update after {max_attempts} attempts: {verify_e}")
                        
                        if not verification_success:
                            logger.info(f"Note: Bandwidth change may still be applied despite verification failure")
                            logger.info(f"This is a known issue with Mininet's interface parameter updates")
                            
                            # Try to force refresh the interface configuration
                            try:
                                logger.debug(f"Attempting to force refresh interface configuration...")
                                # Sometimes Mininet needs the interface to be reconfigured
                                if hasattr(link_to_update.intf1, 'config'):
                                    # Try to reconfigure with the same bandwidth
                                    link_to_update.intf1.config(bw=bandwidth_mbps)
                                    logger.debug(f"Force reconfigured interface with bandwidth {bandwidth_mbps}")
                                    
                                    # Check one more time
                                    time.sleep(0.1)
                                    if hasattr(link_to_update.intf1, 'params') and 'bw' in link_to_update.intf1.params:
                                        final_bw = link_to_update.intf1.params['bw']
                                        if final_bw == bandwidth_mbps:
                                            logger.info(f"✅ Force refresh successful! Final bandwidth: {final_bw} Mbps")
                                        else:
                                            logger.debug(f"Force refresh completed, but bandwidth still shows: {final_bw} Mbps")
                            except Exception as force_e:
                                logger.debug(f"Force refresh attempt failed: {force_e}")
                            
                            # Check system-level traffic control rules as final verification
                            try:
                                logger.debug(f"Checking system-level traffic control rules...")
                                # Try to get the interface name to check tc rules
                                if hasattr(link_to_update.intf1, 'name'):
                                    interface_name = link_to_update.intf1.name
                                    logger.debug(f"Checking tc rules for interface: {interface_name}")
                                    
                                    # This would require root access to check tc rules
                                    # For now, we'll just log that we're checking
                                    logger.info(f"System-level verification: Interface {interface_name} should have tc htb with {bandwidth_mbps}Mbit limit")
                                    logger.info(f"Check with: sudo tc class show dev {interface_name}")
                                    
                            except Exception as tc_e:
                                logger.debug(f"Could not check traffic control rules: {tc_e}")
                            
                    else:
                        logger.warning(f"Cannot update bandwidth - interface config not available")
                else:
                    logger.warning(f"Cannot update bandwidth - link interface not available")
            except Exception as e:
                logger.warning(f"Error updating bandwidth: {e}")
            
            # Update topology data with a small delay to ensure Mininet reflects changes
            try:
                import time
                time.sleep(0.1)  # Small delay to ensure Mininet processes the change
                self.update_topology_data()
                logger.info(f"Topology data refreshed after bandwidth update for {source_id}-{target_id}")
                
                # Check if the bandwidth change is reflected in the topology data
                try:
                    updated_topology = self.get_topology_data()
                    for link in updated_topology.get('links', []):
                        if ((link['source'] == source_id and link['target'] == target_id) or 
                            (link['source'] == target_id and link['target'] == source_id)):
                            logger.info(f"Topology data shows link {source_id}-{target_id} bandwidth: {link.get('bandwidth', 'unknown')}")
                            break
                except Exception as check_e:
                    logger.debug(f"Could not verify bandwidth in topology data: {check_e}")
                    
            except Exception as e:
                logger.warning(f"Error updating topology data after bandwidth change: {e}")
            
            # Prepare response message based on whether Mininet's limit was hit
            if int(new_bandwidth.replace('G', '').replace('M', '')) > 1:  # If original request was >1G
                message = f"Bandwidth request: {new_bandwidth}. Due to Mininet's 1000 Mbps limit, set to {bandwidth_mbps} Mbps (1 Gbps)"
            else:
                message = f"Bandwidth updated to {new_bandwidth} ({bandwidth_mbps} Mbps)"
            
            # Add note about verification if it failed
            if not verification_success:
                message += f" (Note: Mininet verification failed, but traffic shaping is working - check logs for '(500.00Mbit)' confirmation)"
            
            return {'success': True, 'message': message}
            
        except Exception as e:
            logger.error(f"Error updating bandwidth for {source_id}-{target_id}: {e}")
            return {'success': False, 'error': str(e)}

    def get_link_bandwidth(self, source_id, target_id):
        """Get current bandwidth of a link"""
        try:
            if not self.net:
                return {'success': False, 'error': 'Network not initialized'}
            
            # Find the link
            link_to_check = None
            for link in self.net.links:
                try:
                    if (hasattr(link, 'intf1') and hasattr(link, 'intf2') and 
                        link.intf1 and link.intf2 and 
                        hasattr(link.intf1, 'node') and hasattr(link.intf2, 'node') and
                        link.intf1.node and link.intf2.node):
                        
                        if ((link.intf1.node.name == source_id and link.intf2.node.name == target_id) or 
                            (link.intf1.node.name == target_id and link.intf2.node.name == source_id)):
                            link_to_check = link
                            break
                except Exception as e:
                    logger.debug(f"Error checking link {link}: {e}")
                    continue
            
            if not link_to_check:
                return {'success': False, 'error': f'Link {source_id}-{target_id} not found'}
            
            # Get current bandwidth
            current_bw = 'unknown'
            try:
                if hasattr(link_to_check, 'intf1') and link_to_check.intf1:
                    if hasattr(link_to_check.intf1, 'params') and 'bw' in link_to_check.intf1.params:
                        current_bw = link_to_check.intf1.params['bw']
                    elif hasattr(link_to_check.intf1, 'config') and hasattr(link_to_check.intf1.config, 'bw'):
                        current_bw = link_to_check.intf1.config.bw
                    elif hasattr(link_to_check.intf1, 'bw'):
                        current_bw = link_to_check.intf1.bw
            except Exception as e:
                logger.debug(f"Error reading bandwidth: {e}")
            
            return {
                'success': True, 
                'bandwidth': current_bw,
                'bandwidth_mbps': current_bw if isinstance(current_bw, (int, float)) else 'unknown',
                'bandwidth_display': f"{current_bw}Mbit" if isinstance(current_bw, (int, float)) and current_bw < 1000 else 
                                   f"{current_bw/1000:.0f}Gbit" if isinstance(current_bw, (int, float)) and current_bw >= 1000 else 
                                   str(current_bw)
            }
            
        except Exception as e:
            logger.error(f"Error getting bandwidth for {source_id}-{target_id}: {e}")
            return {'success': False, 'error': str(e)}

    def update_link_status(self, source_id, target_id, new_status):
        """Update status of a link (up/down)"""
        try:
            if not self.net:
                return {'success': False, 'error': 'Network not initialized'}
            
            # Find the link
            link_to_update = None
            for link in self.net.links:
                try:
                    if (hasattr(link, 'intf1') and hasattr(link, 'intf2') and 
                        link.intf1 and link.intf2 and 
                        hasattr(link.intf1, 'node') and hasattr(link.intf2, 'node') and
                        link.intf1.node and link.intf2.node):
                        
                        if ((link.intf1.node.name == source_id and link.intf2.node.name == target_id) or 
                            (link.intf1.node.name == target_id and link.intf2.node.name == source_id)):
                            link_to_update = link
                            break
                except Exception as e:
                    logger.debug(f"Error checking link {link}: {e}")
                    continue
            
            if not link_to_update:
                return {'success': False, 'error': f'Link {source_id}-{target_id} not found'}
            
            # Update link status
            try:
                if new_status == 'down':
                    # Bring link down
                    if hasattr(link_to_update, 'intf1') and link_to_update.intf1:
                        link_to_update.intf1.down()
                    if hasattr(link_to_update, 'intf2') and link_to_update.intf2:
                        link_to_update.intf2.down()
                    logger.info(f"Brought link {source_id}-{target_id} down")
                elif new_status == 'up':
                    # Bring link up
                    if hasattr(link_to_update, 'intf1') and link_to_update.intf1:
                        link_to_update.intf1.up()
                    if hasattr(link_to_update, 'intf2') and link_to_update.intf2:
                        link_to_update.intf2.up()
                    logger.info(f"Brought link {source_id}-{target_id} up")
                else:
                    return {'success': False, 'error': f'Invalid status: {new_status}. Use "up" or "down"'}
            except Exception as e:
                logger.warning(f"Error updating link status: {e}")
            
            # Update topology data with a small delay to ensure Mininet reflects changes
            try:
                import time
                time.sleep(0.1)  # Small delay to ensure Mininet processes the change
                self.update_topology_data()
                logger.info(f"Topology data refreshed after status update for {source_id}-{target_id}")
            except Exception as e:
                logger.warning(f"Error updating topology data after status change: {e}")
            
            return {'success': True, 'message': f'Link status updated to {new_status}'}
            
        except Exception as e:
            logger.error(f"Error updating link status for {source_id}-{target_id}: {e}")
            return {'success': False, 'error': str(e)}

    def update_controller_port(self, controller_id, new_port):
        """Update controller port"""
        try:
            if not self.net:
                return {'success': False, 'error': 'Network not initialized'}
            
            # Find the controller
            controller = None
            if hasattr(self.net, 'controllers'):
                for ctrl in self.net.controllers:
                    if hasattr(ctrl, 'name') and ctrl.name == controller_id:
                        controller = ctrl
                        break
            
            if not controller:
                return {'success': False, 'error': f'Controller {controller_id} not found'}
            
            # Update controller port
            try:
                if hasattr(controller, 'port'):
                    old_port = controller.port
                    controller.port = int(new_port)
                    logger.info(f"Updated controller {controller_id} port from {old_port} to {new_port}")
                else:
                    return {'success': False, 'error': f'Controller {controller_id} does not support port changes'}
            except Exception as e:
                logger.warning(f"Error updating controller port: {e}")
                return {'success': False, 'error': f'Cannot update port: {e}'}
            
            # Update topology data with a small delay to ensure Mininet reflects changes
            try:
                import time
                time.sleep(0.1)  # Small delay to ensure Mininet processes the change
                self.update_topology_data()
                logger.info(f"Topology data refreshed after controller port update for {controller_id}")
            except Exception as e:
                logger.warning(f"Error updating topology data after controller port change: {e}")
            
            return {'success': True, 'message': f'Controller port updated to {new_port}'}
            
        except Exception as e:
            logger.error(f"Error updating controller port for {controller_id}: {e}")
            return {'success': False, 'error': str(e)}

    def get_node_interfaces(self, node_id):
        """Get detailed interface information for a node"""
        try:
            if not self.net:
                return {'success': False, 'error': 'Network not initialized'}
            
            # Find the node
            node = None
            if hasattr(self.net, 'hosts'):
                for host in self.net.hosts:
                    if hasattr(host, 'name') and host.name == node_id:
                        node = host
                        break
            
            if not node and hasattr(self.net, 'switches'):
                for switch in self.net.switches:
                    if hasattr(switch, 'name') and switch.name == node_id:
                        node = switch
                        break
            
            if not node:
                return {'success': False, 'error': f'Node {node_id} not found'}
            
            # Get interface information
            interfaces = []
            try:
                if hasattr(node, 'intfs'):
                    for intf_name, intf in node.intfs.items():
                        if intf:
                            intf_info = {
                                'name': intf_name,
                                'ip': getattr(intf, 'IP', 'N/A'),
                                'mac': getattr(intf, 'MAC', 'N/A'),
                                'status': 'up' if getattr(intf, 'isUp', lambda: False)() else 'down'
                            }
                            interfaces.append(intf_info)
            except Exception as e:
                logger.warning(f"Error getting interface info: {e}")
            
            return {
                'success': True,
                'node_id': node_id,
                'interfaces': interfaces,
                'interface_count': len(interfaces)
            }
            
        except Exception as e:
            logger.error(f"Error getting interfaces for {node_id}: {e}")
            return {'success': False, 'error': str(e)}
    
    def _capture_live_configurations(self) -> dict:
        """Capture comprehensive live network configurations from running nodes"""
        configurations = {
            'hosts': {},
            'routers': {},
            'switches': {},
            'flow_tables': {},
            'routing_tables': {},
            'interface_configs': {},
            'router_states': {},  # NEW: Complete router states
            'network_protocols': {},  # NEW: Protocol states
            'firewall_states': {}  # NEW: Firewall states
        }
        
        try:
            if not self.net:
                return configurations
                
            # Capture host configurations
            for host in self.net.hosts:
                try:
                    host_config = {
                        'name': host.name,
                        'ip_addresses': [],
                        'routes': [],
                        'interfaces': {},
                        'processes': []
                    }
                    
                    # Get IP addresses for all interfaces
                    for intf_name, intf in host.intfs.items():
                        if intf and intf_name != 'lo':
                            try:
                                ip = intf.IP() if hasattr(intf, 'IP') and callable(intf.IP) else 'unknown'
                                mac = intf.MAC() if hasattr(intf, 'MAC') and callable(intf.MAC) else 'unknown'
                                host_config['ip_addresses'].append(ip)
                                host_config['interfaces'][intf_name] = {
                                    'ip': ip,
                                    'mac': mac,
                                    'status': 'up' if hasattr(intf, 'isUp') and callable(intf.isUp) and intf.isUp() else 'unknown'
                                }
                            except Exception as e:
                                logger.warning(f"Error getting interface info for {host.name}.{intf_name}: {e}")
                    
                    # Get routing table
                    try:
                        result = host.cmd('ip route show')
                        host_config['routes'] = result.strip().split('\n') if result.strip() else []
                    except Exception as e:
                        logger.warning(f"Error getting routes for {host.name}: {e}")
                    
                    # Get running processes (limited)
                    try:
                        result = host.cmd('ps aux --no-headers | head -10')
                        host_config['processes'] = result.strip().split('\n') if result.strip() else []
                    except Exception as e:
                        logger.warning(f"Error getting processes for {host.name}: {e}")
                    
                    configurations['hosts'][host.name] = host_config
                    
                except Exception as e:
                    logger.warning(f"Error capturing configuration for host {host.name}: {e}")
            
            # Capture switch configurations and flow tables
            for switch in self.net.switches:
                try:
                    switch_config = {
                        'name': switch.name,
                        'interfaces': {},
                        'protocols': []
                    }
                    
                    # Get switch interfaces
                    for intf_name, intf in switch.intfs.items():
                        if intf and intf_name != 'lo':
                            try:
                                switch_config['interfaces'][intf_name] = {
                                    'status': 'up' if hasattr(intf, 'isUp') and callable(intf.isUp) and intf.isUp() else 'unknown',
                                    'mac': intf.MAC() if hasattr(intf, 'MAC') and callable(intf.MAC) else 'unknown'
                                }
                            except Exception as e:
                                logger.warning(f"Error getting interface info for {switch.name}.{intf_name}: {e}")
                    
                    # Get OpenFlow version if available
                    try:
                        result = switch.cmd('ovs-ofctl --version 2>/dev/null | head -1')
                        if result.strip():
                            switch_config['protocols'].append(result.strip())
                    except Exception:
                        pass
                    
                    configurations['switches'][switch.name] = switch_config
                    
                    # Get flow table for this switch
                    try:
                        result = switch.cmd('ovs-ofctl dump-flows ' + switch.name + ' 2>/dev/null')
                        if result.strip():
                            configurations['flow_tables'][switch.name] = result.strip().split('\n')
                        else:
                            configurations['flow_tables'][switch.name] = []
                    except Exception as e:
                        logger.warning(f"Error getting flow table for {switch.name}: {e}")
                        configurations['flow_tables'][switch.name] = []
                        
                except Exception as e:
                    logger.warning(f"Error capturing configuration for switch {switch.name}: {e}")
            
            # Capture comprehensive router states
            for host in self.net.hosts:
                try:
                    if hasattr(host, 'node_type') and host.node_type == 'router':
                        logger.info(f"Capturing comprehensive state for router {host.name}")
                        
                        # Start with basic host config
                        router_config = configurations['hosts'].get(host.name, {}).copy()
                        
                        # Capture comprehensive router state
                        router_state = self._capture_comprehensive_router_state(host)
                        router_config.update(router_state)
                        
                        configurations['routers'][host.name] = router_config
                        configurations['router_states'][host.name] = router_state
                        
                except Exception as e:
                    logger.warning(f"Error capturing router configuration for {host.name}: {e}")
            
            # Capture network-wide protocol states
            try:
                configurations['network_protocols'] = self._capture_network_protocols()
            except Exception as e:
                logger.warning(f"Error capturing network protocols: {e}")
            
            # Capture firewall states for all devices
            try:
                configurations['firewall_states'] = self._capture_firewall_states()
            except Exception as e:
                logger.warning(f"Error capturing firewall states: {e}")
            
            logger.info(f"Captured live configurations: {len(configurations['hosts'])} hosts, "
                       f"{len(configurations['switches'])} switches, {len(configurations['routers'])} routers")
            
        except Exception as e:
            logger.error(f"Error capturing live configurations: {e}")
            configurations['error'] = str(e)
        
        return configurations
    
    def _capture_comprehensive_router_state(self, router):
        """Capture comprehensive state of a router including all interfaces, routes, protocols, and services"""
        try:
            logger.info(f"Starting comprehensive state capture for router {router.name}")
            router_state = {}
            
            # 1. INTERFACE STATE CAPTURE
            logger.debug(f"Capturing interface state for {router.name}")
            router_state['interfaces'] = {}
            
            # Get all interfaces
            interface_list = router.cmd('ip link show | grep -E "^[0-9]+:" | cut -d: -f2 | cut -d@ -f1 | tr -d " "')
            interfaces = [iface.strip() for iface in interface_list.split('\n') if iface.strip() and iface.strip() != 'lo']
            
            for interface in interfaces:
                try:
                    iface_state = {}
                    
                    # Get IP addresses
                    ip_output = router.cmd(f'ip addr show {interface}')
                    iface_state['ip_addresses'] = []
                    for line in ip_output.split('\n'):
                        if 'inet ' in line and not '127.0.0.1' in line:
                            ip_part = line.strip().split('inet ')[1].split(' ')[0]
                            iface_state['ip_addresses'].append(ip_part)
                    
                    # Get MAC address
                    if 'link/ether' in ip_output:
                        for line in ip_output.split('\n'):
                            if 'link/ether' in line:
                                iface_state['mac'] = line.strip().split(' ')[1]
                                break
                    
                    # Get interface status
                    iface_state['status'] = 'up' if 'UP' in ip_output else 'down'
                    
                    # Get MTU
                    mtu_match = [line for line in ip_output.split('\n') if 'mtu ' in line]
                    if mtu_match:
                        iface_state['mtu'] = int(mtu_match[0].split('mtu ')[1].split(' ')[0])
                    
                    # Get interface statistics
                    stats_output = router.cmd(f'cat /sys/class/net/{interface}/statistics/rx_bytes 2>/dev/null || echo 0')
                    iface_state['rx_bytes'] = int(stats_output.strip()) if stats_output.strip().isdigit() else 0
                    
                    stats_output = router.cmd(f'cat /sys/class/net/{interface}/statistics/tx_bytes 2>/dev/null || echo 0')
                    iface_state['tx_bytes'] = int(stats_output.strip()) if stats_output.strip().isdigit() else 0
                    
                    router_state['interfaces'][interface] = iface_state
                    
                except Exception as e:
                    logger.warning(f"Error capturing interface {interface} state: {e}")
            
            # 2. ROUTING STATE CAPTURE
            logger.debug(f"Capturing routing state for {router.name}")
            router_state['routing'] = {}
            
            # Get routing table
            route_output = router.cmd('ip route show')
            router_state['routing']['routes'] = [r.strip() for r in route_output.split('\n') if r.strip()]
            
            # Get default route
            default_route = router.cmd('ip route show default')
            router_state['routing']['default_route'] = default_route.strip() if default_route.strip() else None
            
            # Check IP forwarding
            forwarding = router.cmd('cat /proc/sys/net/ipv4/ip_forward')
            router_state['routing']['ip_forwarding_enabled'] = forwarding.strip() == '1'
            
            # Get ARP table
            arp_output = router.cmd('arp -a')
            router_state['routing']['arp_table'] = [a.strip() for a in arp_output.split('\n') if a.strip()]
            
            # 3. FIREWALL STATE CAPTURE
            logger.debug(f"Capturing firewall state for {router.name}")
            router_state['firewall'] = {}
            
            # Get iptables rules
            iptables_output = router.cmd('iptables -L -n -v --line-numbers')
            router_state['firewall']['filter_rules'] = iptables_output.strip().split('\n') if iptables_output.strip() else []
            
            # Get NAT rules
            nat_output = router.cmd('iptables -t nat -L -n -v --line-numbers 2>/dev/null')
            router_state['firewall']['nat_rules'] = nat_output.strip().split('\n') if nat_output.strip() else []
            
            # Get mangle rules
            mangle_output = router.cmd('iptables -t mangle -L -n -v --line-numbers 2>/dev/null')
            router_state['firewall']['mangle_rules'] = mangle_output.strip().split('\n') if mangle_output.strip() else []
            
            # 4. PROTOCOL STATE CAPTURE
            logger.debug(f"Capturing protocol state for {router.name}")
            router_state['protocols'] = {}
            
            # Check for running routing protocols
            processes = router.cmd('ps aux')
            router_state['protocols']['running_processes'] = []
            
            # Check for common routing daemons
            routing_daemons = ['zebra', 'bgpd', 'ospfd', 'ripd', 'pimd', 'quagga', 'frr']
            for daemon in routing_daemons:
                if daemon in processes:
                    router_state['protocols']['running_processes'].append(daemon)
            
            # Check for DHCP server
            if 'dhcpd' in processes or 'dnsmasq' in processes:
                router_state['protocols']['dhcp_server'] = True
            else:
                router_state['protocols']['dhcp_server'] = False
            
            # 5. SYSTEM STATE CAPTURE
            logger.debug(f"Capturing system state for {router.name}")
            router_state['system'] = {}
            
            # Get hostname
            hostname = router.cmd('hostname')
            router_state['system']['hostname'] = hostname.strip()
            
            # Get DNS configuration
            resolv_conf = router.cmd('cat /etc/resolv.conf 2>/dev/null')
            router_state['system']['dns_config'] = resolv_conf.strip().split('\n') if resolv_conf.strip() else []
            
            # Get system uptime
            uptime = router.cmd('uptime')
            router_state['system']['uptime'] = uptime.strip()
            
            # Get network namespace info (if applicable)
            ns_info = router.cmd('ip netns identify 2>/dev/null')
            router_state['system']['network_namespace'] = ns_info.strip() if ns_info.strip() else None
            
            # 6. BRIDGE AND VLAN STATE (if applicable)
            logger.debug(f"Capturing bridge/VLAN state for {router.name}")
            router_state['bridges'] = {}
            
            # Get bridge information
            bridge_output = router.cmd('brctl show 2>/dev/null')
            if bridge_output.strip() and 'command not found' not in bridge_output:
                router_state['bridges']['bridge_info'] = bridge_output.strip().split('\n')
            
            # Get VLAN information
            vlan_output = router.cmd('cat /proc/net/vlan/config 2>/dev/null')
            if vlan_output.strip():
                router_state['bridges']['vlan_config'] = vlan_output.strip().split('\n')
            
            logger.info(f"Completed comprehensive state capture for router {router.name}")
            logger.debug(f"Captured state keys: {list(router_state.keys())}")
            
            return router_state
            
        except Exception as e:
            logger.error(f"Error capturing comprehensive router state for {router.name}: {e}")
            return {'error': str(e)}
    
    def _capture_network_protocols(self):
        """Capture network-wide protocol information"""
        try:
            protocols = {}
            
            # This would capture network-wide protocol states
            # For now, we'll capture what we can from available routers
            protocols['captured_at'] = datetime.now().isoformat()
            protocols['protocol_summary'] = {}
            
            return protocols
            
        except Exception as e:
            logger.error(f"Error capturing network protocols: {e}")
            return {'error': str(e)}
    
    def _capture_firewall_states(self):
        """Capture firewall states from all network devices"""
        try:
            firewall_states = {}
            
            if not self.net:
                return firewall_states
            
            # Capture firewall states from all hosts (including routers)
            for host in self.net.hosts:
                try:
                    host_firewall = {}
                    
                    # Get iptables status
                    iptables_status = host.cmd('iptables -L -n 2>/dev/null | head -20')
                    if iptables_status.strip():
                        host_firewall['iptables_active'] = True
                        host_firewall['rule_count'] = len([l for l in iptables_status.split('\n') if l.strip() and not l.startswith('Chain')])
                    else:
                        host_firewall['iptables_active'] = False
                    
                    firewall_states[host.name] = host_firewall
                    
                except Exception as e:
                    logger.warning(f"Error capturing firewall state for {host.name}: {e}")
            
            return firewall_states
            
        except Exception as e:
            logger.error(f"Error capturing firewall states: {e}")
            return {'error': str(e)}
    
    def _force_capture_live_topology(self):
        """Force capture topology data from live network when update_topology_data fails"""
        try:
            if not self.net:
                return
                
            logger.info("Force capturing live topology data...")
            
            # Initialize topology data structure
            self.topology_data = {
                'nodes': [],
                'links': [],
                'controllers': [],
                'stats': {}
            }
            
            # Capture hosts
            if hasattr(self.net, 'hosts'):
                for host in self.net.hosts:
                    try:
                        node_type = 'router' if hasattr(host, 'node_type') and host.node_type == 'router' else 'host'
                        
                        # Get IP from first non-loopback interface
                        ip = 'unknown'
                        mac = 'unknown'
                        for intf_name, intf in host.intfs.items():
                            if intf and intf_name != 'lo':
                                try:
                                    ip = intf.IP() if hasattr(intf, 'IP') and callable(intf.IP) else 'unknown'
                                    mac = intf.MAC() if hasattr(intf, 'MAC') and callable(intf.MAC) else 'unknown'
                                    break
                                except:
                                    continue
                        
                        node_info = {
                            'id': host.name,
                            'type': node_type,
                            'ip': ip,
                            'mac': mac,
                            'status': 'active'
                        }
                        
                        # Add position if available
                        if hasattr(self, 'node_positions') and host.name in self.node_positions:
                            node_info.update(self.node_positions[host.name])
                        
                        self.topology_data['nodes'].append(node_info)
                        
                    except Exception as e:
                        logger.warning(f"Error capturing host {host.name}: {e}")
            
            # Capture switches
            if hasattr(self.net, 'switches'):
                for switch in self.net.switches:
                    try:
                        node_info = {
                            'id': switch.name,
                            'type': 'switch',
                            'ip': 'N/A',
                            'mac': 'N/A',
                            'status': 'active'
                        }
                        
                        # Add position if available
                        if hasattr(self, 'node_positions') and switch.name in self.node_positions:
                            node_info.update(self.node_positions[switch.name])
                        
                        self.topology_data['nodes'].append(node_info)
                        
                    except Exception as e:
                        logger.warning(f"Error capturing switch {switch.name}: {e}")
            
            # Capture controllers
            if hasattr(self.net, 'controllers'):
                for controller in self.net.controllers:
                    try:
                        controller_info = {
                            'id': controller.name,
                            'type': 'controller',
                            'ip': controller.IP() if hasattr(controller, 'IP') and callable(controller.IP) else '127.0.0.1',
                            'mac': 'N/A',
                            'status': 'active' if self.ryu_controller and self.ryu_controller.is_running else 'inactive'
                        }
                        
                        # Add position if available
                        if hasattr(self, 'node_positions') and controller.name in self.node_positions:
                            controller_info.update(self.node_positions[controller.name])
                        
                        self.topology_data['nodes'].append(controller_info)
                        self.topology_data['controllers'].append(controller_info)
                        
                    except Exception as e:
                        logger.warning(f"Error capturing controller {controller.name}: {e}")
            
            # Capture links by examining node interfaces
            captured_links = set()
            for node in list(self.net.hosts) + list(self.net.switches):
                try:
                    for intf_name, intf in node.intfs.items():
                        if intf and hasattr(intf, 'link') and intf.link:
                            link = intf.link
                            if hasattr(link, 'intf1') and hasattr(link, 'intf2'):
                                node1 = link.intf1.node.name if hasattr(link.intf1, 'node') else 'unknown'
                                node2 = link.intf2.node.name if hasattr(link.intf2, 'node') else 'unknown'
                                
                                # Create a sorted tuple to avoid duplicate links
                                link_key = tuple(sorted([node1, node2]))
                                
                                if link_key not in captured_links and node1 != 'unknown' and node2 != 'unknown':
                                    link_info = {
                                        'source': link_key[0],
                                        'target': link_key[1],
                                        'bandwidth': getattr(link, 'bw', 10),  # Default 10 Mbps
                                        'delay': getattr(link, 'delay', '0ms'),
                                        'loss': getattr(link, 'loss', 0),
                                        'status': 'active'
                                    }
                                    
                                    self.topology_data['links'].append(link_info)
                                    captured_links.add(link_key)
                                    
                except Exception as e:
                    logger.warning(f"Error capturing links for {node.name}: {e}")
            
            logger.info(f"Force captured {len(self.topology_data['nodes'])} nodes and {len(self.topology_data['links'])} links")
            
        except Exception as e:
            logger.error(f"Error in force capture live topology: {e}")
    
    def create_simulation_snapshot(self) -> dict:
        """
        Create a complete snapshot of the current simulation state
        
        Returns:
            dict: Complete simulation snapshot data
        """
        logger.info("Creating simulation snapshot...")
        logger.info(f"Network running status: {self.is_running}")
        logger.info(f"Network object exists: {self.net is not None}")
        if self.net:
            logger.info(f"Hosts count: {len(self.net.hosts) if hasattr(self.net, 'hosts') else 'N/A'}")
            logger.info(f"Switches count: {len(self.net.switches) if hasattr(self.net, 'switches') else 'N/A'}")
            logger.info(f"Controllers count: {len(self.net.controllers) if hasattr(self.net, 'controllers') else 'N/A'}")
        
        # Update topology data to get latest state
        self.update_topology_data()
        
        logger.info(f"Topology data after update - Nodes: {len(self.topology_data.get('nodes', []))}, Links: {len(self.topology_data.get('links', []))}")
        
        # If network is running but we still don't have topology data, force capture it
        if self.is_running and self.net and (not self.topology_data.get('nodes') and not self.topology_data.get('links')):
            logger.warning("Network is running but topology data is empty, forcing topology capture...")
            self._force_capture_live_topology()
            logger.info(f"After forced capture - Nodes: {len(self.topology_data.get('nodes', []))}, Links: {len(self.topology_data.get('links', []))}")
        
        # If still no topology data from running network, try to get stored topology configuration
        if (not self.topology_data.get('nodes') and not self.topology_data.get('links')):
            logger.info("No running network topology found, checking for stored topology configuration...")
            
            # Check if we have stored topology configuration (from topology builder)
            stored_topology = getattr(self, '_stored_topology', None)
            if stored_topology:
                logger.info(f"Found stored topology with {len(stored_topology.get('nodes', []))} nodes and {len(stored_topology.get('links', []))} links")
                self.topology_data = stored_topology.copy()
            else:
                logger.warning("No stored topology configuration found")
        
        # Capture live configurations if network is running
        live_configurations = {}
        if self.is_running and self.net:
            logger.info("Capturing live network configurations...")
            live_configurations = self._capture_live_configurations()
        
        # Debug tracked configurations before snapshot
        self.debug_tracked_configurations()
        
        # Capture Mininet manager state
        mininet_state = {
            'is_running': self.is_running,
            'topology_data': self.topology_data,
            'node_positions': getattr(self, 'node_positions', {}),
            'controller_config': getattr(self, 'controller_config', []),
            'custom_configs': getattr(self, 'custom_configs', {}),
            'live_configurations': live_configurations,
            'applied_configurations': self.get_applied_configurations()
        }
        
        # Capture controller state
        try:
            controller_logs = self.get_controller_logs()
            if isinstance(controller_logs, list):
                recent_logs = controller_logs[-100:] if len(controller_logs) > 0 else []
            else:
                recent_logs = []
        except Exception as e:
            logger.warning(f"Error getting controller logs: {e}")
            recent_logs = []
            
        controller_state = {
            'is_running': self.ryu_controller.is_running if self.ryu_controller else False,
            'controller_type': getattr(self.ryu_controller, 'controller_type', None),
            'status': self.get_controller_status(),
            'logs': recent_logs
        }
        
        # Capture network statistics
        network_stats = {
            'hosts': [],
            'switches': [],
            'controllers': [],
            'flow_stats': {}
        }
        
        if self.is_running and self.net:
            try:
                # Get flow statistics safely
                try:
                    flow_stats = self.get_flow_stats()
                    if flow_stats and isinstance(flow_stats, dict):
                        network_stats['flow_stats'] = flow_stats
                except Exception as e:
                    logger.warning(f"Error getting flow stats: {e}")
                    network_stats['flow_stats'] = {}
                
                # Collect host information
                try:
                    for host in self.net.hosts:
                        try:
                            host_info = {
                                'name': getattr(host, 'name', 'unknown'),
                                'ip': host.IP() if hasattr(host, 'IP') and callable(getattr(host, 'IP', None)) else 'unknown',
                                'mac': host.MAC() if hasattr(host, 'MAC') and callable(getattr(host, 'MAC', None)) else 'unknown',
                                'interfaces': []
                            }
                            
                            # Get interface information safely
                            try:
                                if hasattr(host, 'intfList') and callable(getattr(host, 'intfList', None)):
                                    for intf in host.intfList():
                                        try:
                                            if hasattr(intf, 'name') and intf.name != 'lo':
                                                intf_info = {
                                                    'name': getattr(intf, 'name', 'unknown'),
                                                    'ip': intf.IP() if hasattr(intf, 'IP') and callable(getattr(intf, 'IP', None)) else None,
                                                    'mac': intf.MAC() if hasattr(intf, 'MAC') and callable(getattr(intf, 'MAC', None)) else None,
                                                    'status': 'up' if hasattr(intf, 'isUp') and callable(getattr(intf, 'isUp', None)) and intf.isUp() else 'down'
                                                }
                                                host_info['interfaces'].append(intf_info)
                                        except Exception as e:
                                            logger.warning(f"Error processing interface {getattr(intf, 'name', 'unknown')}: {e}")
                            except Exception as e:
                                logger.warning(f"Error getting interfaces for host {host_info['name']}: {e}")
                            
                            network_stats['hosts'].append(host_info)
                        except Exception as e:
                            logger.warning(f"Error processing host: {e}")
                except Exception as e:
                    logger.warning(f"Error collecting host information: {e}")
                
                # Collect switch information
                try:
                    for switch in self.net.switches:
                        try:
                            switch_info = {
                                'name': getattr(switch, 'name', 'unknown'),
                                'dpid': getattr(switch, 'dpid', 'unknown'),
                                'interfaces': []
                            }
                            
                            # Get interface information safely
                            try:
                                if hasattr(switch, 'intfList') and callable(getattr(switch, 'intfList', None)):
                                    for intf in switch.intfList():
                                        try:
                                            intf_info = {
                                                'name': getattr(intf, 'name', 'unknown'),
                                                'mac': intf.MAC() if hasattr(intf, 'MAC') and callable(getattr(intf, 'MAC', None)) else None,
                                                'status': 'up' if hasattr(intf, 'isUp') and callable(getattr(intf, 'isUp', None)) and intf.isUp() else 'down'
                                            }
                                            switch_info['interfaces'].append(intf_info)
                                        except Exception as e:
                                            logger.warning(f"Error processing switch interface: {e}")
                            except Exception as e:
                                logger.warning(f"Error getting interfaces for switch {switch_info['name']}: {e}")
                            
                            network_stats['switches'].append(switch_info)
                        except Exception as e:
                            logger.warning(f"Error processing switch: {e}")
                except Exception as e:
                    logger.warning(f"Error collecting switch information: {e}")
                
                # Collect controller information
                try:
                    for controller in self.net.controllers:
                        try:
                            controller_info = {
                                'name': getattr(controller, 'name', 'unknown'),
                                'ip': controller.IP() if hasattr(controller, 'IP') and callable(getattr(controller, 'IP', None)) else 'unknown',
                                'port': getattr(controller, 'port', 6633)
                            }
                            network_stats['controllers'].append(controller_info)
                        except Exception as e:
                            logger.warning(f"Error processing controller: {e}")
                except Exception as e:
                    logger.warning(f"Error collecting controller information: {e}")
                    
            except Exception as e:
                logger.error(f"Error collecting network stats: {e}")
                network_stats['error'] = str(e)
        
        # Create complete snapshot
        try:
            snapshot_data = {
                'mininet_state': mininet_state,
                'controller_state': controller_state,
                'network_stats': network_stats,
                'timestamp': datetime.now().isoformat(),
                'version': '1.0'
            }
            
            # Test serialization to catch any unhashable type issues
            import json
            json.dumps(snapshot_data, default=str)
            
            logger.info("Simulation snapshot created successfully")
            return snapshot_data
        except Exception as e:
            logger.error(f"Error creating final snapshot data: {e}")
            # Return a minimal snapshot if full snapshot fails
            return {
                'mininet_state': {
                    'is_running': self.is_running,
                    'topology_data': self.topology_data,
                    'node_positions': {},
                    'controller_config': [],
                    'custom_configs': {}
                },
                'controller_state': {
                    'is_running': False,
                    'controller_type': None,
                    'status': {},
                    'logs': []
                },
                'network_stats': {
                    'hosts': [],
                    'switches': [],
                    'controllers': [],
                    'flow_stats': {},
                    'error': str(e)
                },
                'timestamp': datetime.now().isoformat(),
                'version': '1.0',
                'error': f"Partial snapshot due to error: {str(e)}"
            }
    
    def set_topology_configuration(self, topology_config):
        """Set topology configuration for snapshots when network is not running"""
        self._stored_topology = {
            'nodes': topology_config.get('nodes', []),
            'links': topology_config.get('links', []),
            'controllers': [node for node in topology_config.get('nodes', []) if node.get('type') == 'controller'],
            'stats': {}
        }
        
        # Store node positions
        self.node_positions = {}
        for node in topology_config.get('nodes', []):
            if node.get('id') and node.get('x') is not None and node.get('y') is not None:
                self.node_positions[node['id']] = {'x': node['x'], 'y': node['y']}
        
        # Store controller config
        self.controller_config = [node for node in topology_config.get('nodes', []) if node.get('type') == 'controller']
        
        logger.info(f"Stored topology configuration with {len(topology_config.get('nodes', []))} nodes and {len(topology_config.get('links', []))} links")
    
    def restore_simulation_snapshot(self, snapshot_data: dict) -> bool:
        """
        Restore simulation state from a snapshot
        
        Args:
            snapshot_data: Complete simulation snapshot data
            
        Returns:
            bool: True if restoration was successful
        """
        logger.info("Restoring simulation from snapshot...")
        
        try:
            # Stop current network if running
            if self.is_running:
                self.stop_network()
            
            # Extract snapshot components
            mininet_state = snapshot_data.get('mininet_state', {})
            controller_state = snapshot_data.get('controller_state', {})
            
            # Restore Mininet manager state
            self.node_positions = mininet_state.get('node_positions', {})
            self.controller_config = mininet_state.get('controller_config', [])
            self.custom_configs = mininet_state.get('custom_configs', {})
            
            # Restore tracked configurations
            self.applied_configurations = mininet_state.get('applied_configurations', {
                'device_configs': {},
                'terminal_commands': {},
                'api_operations': [],
                'routing_configs': {},
                'firewall_configs': {},
                'interface_configs': {},
                'service_configs': {}
            })
            
            # Always restore topology data if available
            topology_data = mininet_state.get('topology_data', {})
            
            # Store the topology configuration for future snapshots
            if topology_data:
                self._stored_topology = topology_data
            
            if topology_data and (topology_data.get('nodes') or topology_data.get('links')):
                logger.info(f"Restoring topology with {len(topology_data.get('nodes', []))} nodes and {len(topology_data.get('links', []))} links")
                
                # Create network from topology data
                if self.create_custom_topology(topology_data):
                    logger.info("Network topology restored successfully")
                    
                    # Start the network if it was running in the snapshot
                    if mininet_state.get('is_running', False):
                        logger.info("Starting network as it was running in snapshot...")
                        if self.start_network():
                            logger.info("Network started successfully")
                            
                            # Apply live configurations if available
                            live_configurations = mininet_state.get('live_configurations', {})
                            if live_configurations:
                                logger.info("Applying live configurations from snapshot...")
                                self._apply_live_configurations(live_configurations)
                            
                            # Apply tracked configurations if available
                            if self.applied_configurations:
                                logger.info("Applying tracked configurations from snapshot...")
                                self._apply_tracked_configurations()
                        else:
                            logger.warning("Failed to start network")
                    
                    # Restore controller if it was running
                    if controller_state.get('is_running', False):
                        controller_type = controller_state.get('controller_type', 'simple_switch_13')
                        logger.info(f"Starting controller with type: {controller_type}")
                        self.start_ryu_controller(controller_type)
                        logger.info("Controller restored successfully")
                    
                    return True
                else:
                    logger.error("Failed to restore network topology")
                    return False
            else:
                logger.warning("No topology data found in snapshot to restore")
                return True
                
        except Exception as e:
            logger.error(f"Error restoring simulation snapshot: {e}")
            return False
    
    def _apply_live_configurations(self, live_configurations: dict):
        """Apply live configurations from snapshot to restore network state"""
        try:
            if not self.net or not self.is_running:
                logger.warning("Cannot apply live configurations: network not running")
                return
            
            logger.info("Applying live configurations to restore network state...")
            
            # Apply host configurations
            host_configs = live_configurations.get('hosts', {})
            for host_name, config in host_configs.items():
                try:
                    # Find the host in the current network
                    host = None
                    for h in self.net.hosts:
                        if h.name == host_name:
                            host = h
                            break
                    
                    if not host:
                        logger.warning(f"Host {host_name} not found in current network")
                        continue
                    
                    # Apply routing table entries
                    routes = config.get('routes', [])
                    for route in routes:
                        if route and route.strip() and not route.startswith('default'):
                            try:
                                # Skip localhost and link-local routes
                                if 'dev lo' not in route and '127.0.0.1' not in route:
                                    host.cmd(f'ip route add {route} 2>/dev/null || true')
                            except Exception as e:
                                logger.warning(f"Error applying route '{route}' to {host_name}: {e}")
                    
                    logger.debug(f"Applied {len(routes)} routes to host {host_name}")
                    
                except Exception as e:
                    logger.warning(f"Error applying configuration to host {host_name}: {e}")
            
            # Apply router configurations
            router_configs = live_configurations.get('routers', {})
            for router_name, config in router_configs.items():
                try:
                    # Find the router in the current network
                    router = None
                    for h in self.net.hosts:
                        if h.name == router_name:
                            router = h
                            break
                    
                    if not router:
                        logger.warning(f"Router {router_name} not found in current network")
                        continue
                    
                    # Enable IP forwarding if it was enabled
                    if config.get('ip_forwarding', False):
                        router.cmd('echo 1 > /proc/sys/net/ipv4/ip_forward')
                        logger.debug(f"Enabled IP forwarding on router {router_name}")
                    
                    # Apply firewall rules (basic restoration)
                    firewall_rules = config.get('firewall_rules', [])
                    if firewall_rules:
                        # Clear existing rules first
                        router.cmd('iptables -F 2>/dev/null || true')
                        router.cmd('iptables -X 2>/dev/null || true')
                        
                        # Note: Full iptables restoration is complex and could be dangerous
                        # For now, we just log that rules were present
                        logger.debug(f"Router {router_name} had {len(firewall_rules)} firewall rules (not fully restored)")
                    
                except Exception as e:
                    logger.warning(f"Error applying configuration to router {router_name}: {e}")
            
            # Apply switch flow tables (if available and safe)
            flow_tables = live_configurations.get('flow_tables', {})
            for switch_name, flows in flow_tables.items():
                try:
                    if flows and isinstance(flows, list):
                        # Find the switch
                        switch = None
                        for s in self.net.switches:
                            if s.name == switch_name:
                                switch = s
                                break
                        
                        if switch:
                            # Note: Restoring flow tables can be complex and might interfere with controller
                            # For now, we just log that flows were present
                            logger.debug(f"Switch {switch_name} had {len(flows)} flow entries (controller will repopulate)")
                        
                except Exception as e:
                    logger.warning(f"Error processing flow table for switch {switch_name}: {e}")
            
            logger.info(f"Live configuration restoration completed: "
                       f"{len(host_configs)} hosts, {len(router_configs)} routers, {len(flow_tables)} switches")
            
        except Exception as e:
            logger.error(f"Error applying live configurations: {e}")
    
    def track_device_configuration(self, device_name: str, config_type: str, config_data: dict, result: dict = None):
        """Track applied device configuration with enhanced interface tracking"""
        try:
            timestamp = datetime.now().isoformat()
            
            if device_name not in self.applied_configurations['device_configs']:
                self.applied_configurations['device_configs'][device_name] = []
            
            # Enhanced configuration data with current device state
            enhanced_config_data = config_data.copy()
            
            # For routers, capture current interface state
            if config_type == 'router_config' and self.net and self.is_running:
                try:
                    device = self._find_network_device(device_name)
                    if device:
                        enhanced_config_data['captured_interface_state'] = self._capture_device_interface_state(device)
                        enhanced_config_data['captured_routing_state'] = self._capture_device_routing_state(device)
                        logger.debug(f"Enhanced router config data for {device_name} with current interface/routing state")
                except Exception as e:
                    logger.warning(f"Could not enhance router config data for {device_name}: {e}")
            
            config_entry = {
                'timestamp': timestamp,
                'config_type': config_type,
                'config_data': enhanced_config_data,
                'result': result or {},
                'success': result.get('success', True) if result else True
            }
            
            self.applied_configurations['device_configs'][device_name].append(config_entry)
            
            # Also track interface-specific configurations separately
            if config_type == 'router_config':
                self._track_router_interface_configs(device_name, enhanced_config_data, timestamp)
            
            logger.info(f"Tracked {config_type} configuration for {device_name}")
            
        except Exception as e:
            logger.warning(f"Error tracking device configuration: {e}")
    
    def _capture_device_interface_state(self, device):
        """Capture current interface state of a device"""
        try:
            interface_state = {}
            
            # Get interface list
            result = device.cmd('ip link show')
            interfaces = []
            for line in result.split('\n'):
                if ': ' in line and '@' not in line:
                    parts = line.split(': ')
                    if len(parts) >= 2:
                        interface_name = parts[1].split('@')[0]
                        interfaces.append(interface_name)
            
            # Get detailed info for each interface
            for interface in interfaces:
                if interface != 'lo':  # Skip loopback
                    interface_info = {}
                    
                    # Get IP addresses
                    ip_result = device.cmd(f'ip addr show {interface}')
                    ips = []
                    for line in ip_result.split('\n'):
                        if 'inet ' in line:
                            ip_part = line.strip().split('inet ')[1].split(' ')[0]
                            ips.append(ip_part)
                    interface_info['ip_addresses'] = ips
                    
                    # Get MAC address
                    for line in ip_result.split('\n'):
                        if 'link/ether' in line:
                            mac = line.strip().split(' ')[1]
                            interface_info['mac'] = mac
                            break
                    
                    # Get interface status
                    if 'UP' in ip_result:
                        interface_info['status'] = 'up'
                    else:
                        interface_info['status'] = 'down'
                    
                    # Get MTU
                    for line in ip_result.split('\n'):
                        if 'mtu ' in line:
                            mtu = line.split('mtu ')[1].split(' ')[0]
                            interface_info['mtu'] = int(mtu)
                            break
                    
                    interface_state[interface] = interface_info
            
            return interface_state
            
        except Exception as e:
            logger.warning(f"Error capturing device interface state: {e}")
            return {}
    
    def _capture_device_routing_state(self, device):
        """Capture current routing state of a device"""
        try:
            routing_state = {}
            
            # Get routing table
            result = device.cmd('ip route show')
            routes = []
            for line in result.split('\n'):
                line = line.strip()
                if line and not line.startswith('default'):
                    routes.append(line)
            routing_state['routes'] = routes
            
            # Get default route
            default_result = device.cmd('ip route show default')
            if default_result.strip():
                routing_state['default_route'] = default_result.strip()
            
            # For routers, check IP forwarding
            forwarding_result = device.cmd('cat /proc/sys/net/ipv4/ip_forward')
            routing_state['ip_forwarding'] = forwarding_result.strip() == '1'
            
            return routing_state
            
        except Exception as e:
            logger.warning(f"Error capturing device routing state: {e}")
            return {}
    
    def _track_router_interface_configs(self, device_name: str, config_data: dict, timestamp: str):
        """Track router interface configurations separately for detailed restoration"""
        try:
            interface_config = config_data.get('interface_config', {})
            if not interface_config:
                return
            
            if device_name not in self.applied_configurations['interface_configs']:
                self.applied_configurations['interface_configs'][device_name] = []
            
            for interface_name, interface_settings in interface_config.items():
                interface_entry = {
                    'timestamp': timestamp,
                    'interface_name': interface_name,
                    'settings': interface_settings,
                    'device_type': 'router'
                }
                
                self.applied_configurations['interface_configs'][device_name].append(interface_entry)
                logger.debug(f"Tracked interface {interface_name} config for router {device_name}")
            
            # Also track routing configurations
            static_routes = config_data.get('static_routes', [])
            if static_routes:
                if device_name not in self.applied_configurations['routing_configs']:
                    self.applied_configurations['routing_configs'][device_name] = []
                
                routing_entry = {
                    'timestamp': timestamp,
                    'static_routes': static_routes,
                    'device_type': 'router'
                }
                
                self.applied_configurations['routing_configs'][device_name].append(routing_entry)
                logger.debug(f"Tracked {len(static_routes)} static routes for router {device_name}")
            
        except Exception as e:
            logger.error(f"Error tracking router interface configs: {e}")
    
    def track_terminal_command(self, device_name: str, command: str, result: str = None, success: bool = True):
        """Track terminal command executed on device"""
        try:
            timestamp = datetime.now().isoformat()
            
            if device_name not in self.applied_configurations['terminal_commands']:
                self.applied_configurations['terminal_commands'][device_name] = []
            
            command_entry = {
                'timestamp': timestamp,
                'command': command,
                'result': result or '',
                'success': success
            }
            
            self.applied_configurations['terminal_commands'][device_name].append(command_entry)
            logger.debug(f"Tracked terminal command for {device_name}: {command}")
            
        except Exception as e:
            logger.warning(f"Error tracking terminal command: {e}")
    
    def track_api_operation(self, operation_type: str, operation_data: dict, result: dict = None):
        """Track API operation performed"""
        try:
            timestamp = datetime.now().isoformat()
            
            operation_entry = {
                'timestamp': timestamp,
                'operation_type': operation_type,
                'operation_data': operation_data,
                'result': result or {},
                'success': result.get('success', True) if result else True
            }
            
            self.applied_configurations['api_operations'].append(operation_entry)
            logger.info(f"Tracked API operation: {operation_type}")
            
        except Exception as e:
            logger.warning(f"Error tracking API operation: {e}")
    
    def get_applied_configurations(self) -> dict:
        """Get all tracked configurations"""
        return self.applied_configurations.copy()
    
    def clear_configuration_tracking(self):
        """Clear all tracked configurations"""
        self.applied_configurations = {
            'device_configs': {},
            'terminal_commands': {},
            'api_operations': [],
            'routing_configs': {},
            'firewall_configs': {},
            'interface_configs': {},
            'service_configs': {}
        }
        logger.info("Configuration tracking cleared")
    
    def debug_tracked_configurations(self):
        """Debug method to log all tracked configurations"""
        try:
            logger.info("=== TRACKED CONFIGURATIONS DEBUG ===")
            
            # Debug device configs
            device_configs = self.applied_configurations.get('device_configs', {})
            logger.info(f"Device configs tracked: {len(device_configs)} devices")
            for device_name, configs in device_configs.items():
                logger.info(f"  {device_name}: {len(configs)} configurations")
                for i, config in enumerate(configs):
                    config_type = config.get('config_type', 'unknown')
                    timestamp = config.get('timestamp', 'unknown')
                    success = config.get('success', False)
                    logger.info(f"    [{i+1}] {config_type} at {timestamp} - {'SUCCESS' if success else 'FAILED'}")
            
            # Debug terminal commands
            terminal_commands = self.applied_configurations.get('terminal_commands', {})
            logger.info(f"Terminal commands tracked: {sum(len(cmds) for cmds in terminal_commands.values())} total")
            for device_name, commands in terminal_commands.items():
                logger.info(f"  {device_name}: {len(commands)} commands")
            
            # Debug API operations
            api_operations = self.applied_configurations.get('api_operations', [])
            logger.info(f"API operations tracked: {len(api_operations)}")
            for i, op in enumerate(api_operations):
                op_type = op.get('operation_type', 'unknown')
                timestamp = op.get('timestamp', 'unknown')
                success = op.get('result', {}).get('success', False)
                logger.info(f"  [{i+1}] {op_type} at {timestamp} - {'SUCCESS' if success else 'FAILED'}")
            
            # Debug interface configurations
            interface_configs = self.applied_configurations.get('interface_configs', {})
            logger.info(f"Interface configs tracked: {sum(len(interfaces) for interfaces in interface_configs.values())} total")
            for device_name, interfaces in interface_configs.items():
                logger.info(f"  {device_name}: {len(interfaces)} interface configurations")
                for i, interface in enumerate(interfaces):
                    interface_name = interface.get('interface_name', 'unknown')
                    timestamp = interface.get('timestamp', 'unknown')
                    settings = interface.get('settings', {})
                    logger.info(f"    [{i+1}] {interface_name} at {timestamp} - {len(settings)} settings")
            
            # Debug routing configurations
            routing_configs = self.applied_configurations.get('routing_configs', {})
            logger.info(f"Routing configs tracked: {sum(len(routes) for routes in routing_configs.values())} total")
            for device_name, routes in routing_configs.items():
                logger.info(f"  {device_name}: {len(routes)} routing configurations")
                for i, route_config in enumerate(routes):
                    timestamp = route_config.get('timestamp', 'unknown')
                    static_routes = route_config.get('static_routes', [])
                    logger.info(f"    [{i+1}] {len(static_routes)} static routes at {timestamp}")
            
            logger.info("=== END TRACKED CONFIGURATIONS DEBUG ===")
            
        except Exception as e:
            logger.error(f"Error in debug_tracked_configurations: {e}")
    
    def _apply_tracked_configurations(self):
        """Apply tracked configurations during snapshot restoration"""
        try:
            if not self.net or not self.is_running:
                logger.warning("Cannot apply tracked configurations: network not running")
                return
            
            logger.info("=== APPLYING TRACKED CONFIGURATIONS ===")
            
            # Debug what we have in applied_configurations
            logger.info(f"Applied configurations structure:")
            for key, value in self.applied_configurations.items():
                if isinstance(value, dict):
                    logger.info(f"  {key}: {len(value)} devices")
                    for device_name, device_data in value.items():
                        if isinstance(device_data, list):
                            logger.info(f"    {device_name}: {len(device_data)} entries")
                        else:
                            logger.info(f"    {device_name}: {type(device_data)}")
                elif isinstance(value, list):
                    logger.info(f"  {key}: {len(value)} entries")
            
            # Apply device configurations
            device_configs = self.applied_configurations.get('device_configs', {})
            logger.info(f"Processing {len(device_configs)} devices with configurations")
            
            for device_name, configs in device_configs.items():
                try:
                    logger.info(f"=== Processing device: {device_name} ===")
                    
                    # Find the device in the current network
                    device = self._find_network_device(device_name)
                    if not device:
                        logger.error(f"Device {device_name} not found in current network")
                        # Debug available devices
                        logger.info("Available devices in network:")
                        if self.net:
                            for host in self.net.hosts:
                                logger.info(f"  Host: {host.name}")
                            for switch in self.net.switches:
                                logger.info(f"  Switch: {switch.name}")
                            for controller in self.net.controllers:
                                logger.info(f"  Controller: {controller.name}")
                        continue
                    
                    logger.info(f"Found device {device_name}, applying {len(configs)} configurations")
                    
                    # Apply each configuration in chronological order
                    for i, config in enumerate(sorted(configs, key=lambda x: x.get('timestamp', ''))):
                        logger.info(f"  Config [{i+1}]: {config.get('config_type', 'unknown')} - Success: {config.get('success', True)}")
                        
                        if config.get('success', True):
                            logger.info(f"  Applying config: {config.get('config_type', 'unknown')}")
                            logger.debug(f"  Config data keys: {list(config.get('config_data', {}).keys())}")
                            self._apply_device_config(device, config)
                        else:
                            logger.warning(f"  Skipping failed config: {config.get('config_type', 'unknown')}")
                            
                except Exception as e:
                    logger.error(f"Error applying configurations to {device_name}: {e}")
                    import traceback
                    logger.error(f"Traceback: {traceback.format_exc()}")
            
            # Apply terminal commands
            terminal_commands = self.applied_configurations.get('terminal_commands', {})
            for device_name, commands in terminal_commands.items():
                try:
                    device = self._find_network_device(device_name)
                    if not device:
                        continue
                    
                    logger.info(f"Applying {len(commands)} terminal commands to {device_name}")
                    
                    # Apply each command in chronological order
                    for cmd in sorted(commands, key=lambda x: x.get('timestamp', '')):
                        if cmd.get('success', True):
                            self._apply_terminal_command(device, cmd)
                            
                except Exception as e:
                    logger.warning(f"Error applying terminal commands to {device_name}: {e}")
            
            logger.info("Tracked configurations applied successfully")
            
        except Exception as e:
            logger.error(f"Error applying tracked configurations: {e}")
    
    def _find_network_device(self, device_name: str):
        """Find a device in the current network by name"""
        try:
            if not self.net:
                return None
            
            # Check hosts (including routers)
            for host in self.net.hosts:
                if host.name == device_name:
                    return host
            
            # Check switches
            for switch in self.net.switches:
                if switch.name == device_name:
                    return switch
            
            # Check controllers
            for controller in self.net.controllers:
                if controller.name == device_name:
                    return controller
            
            return None
            
        except Exception as e:
            logger.warning(f"Error finding device {device_name}: {e}")
            return None
    
    def _apply_device_config(self, device, config):
        """Apply a specific device configuration"""
        try:
            config_type = config.get('config_type', '')
            config_data = config.get('config_data', {})
            
            logger.info(f"Applying {config_type} config to {device.name}")
            
            if config_type == 'router_config':
                # Apply router-specific configuration
                self._apply_router_configuration(device, config_data)
            
            elif config_type == 'host_config':
                # Apply host-specific configuration
                self._apply_host_configuration(device, config_data)
            
            elif config_type == 'switch_config':
                # Apply switch-specific configuration
                self._apply_switch_configuration(device, config_data)
            
            elif config_type == 'interface_config':
                # Apply interface configuration
                for interface, settings in config_data.items():
                    if 'ip' in settings:
                        device.cmd(f'ip addr add {settings["ip"]} dev {interface} 2>/dev/null || true')
                    if 'status' in settings and settings['status'] == 'up':
                        device.cmd(f'ip link set {interface} up 2>/dev/null || true')
            
            elif config_type == 'routing_config':
                # Apply routing configuration
                routes = config_data.get('routes', [])
                for route in routes:
                    device.cmd(f'ip route add {route} 2>/dev/null || true')
            
            elif config_type == 'firewall_config':
                # Apply firewall rules (basic)
                rules = config_data.get('rules', [])
                for rule in rules:
                    device.cmd(f'iptables {rule} 2>/dev/null || true')
            
            elif config_type == 'service_config':
                # Apply service configuration
                services = config_data.get('services', [])
                for service in services:
                    if service.get('action') == 'start':
                        device.cmd(f'systemctl start {service["name"]} 2>/dev/null || true')
                    elif service.get('action') == 'enable':
                        device.cmd(f'systemctl enable {service["name"]} 2>/dev/null || true')
            
            # Add more configuration types as needed
            
        except Exception as e:
            logger.warning(f"Error applying device config to {device.name}: {e}")
    
    def _apply_router_configuration(self, router, config_data):
        """Apply router-specific configuration with enhanced interface restoration"""
        try:
            logger.info(f"=== APPLYING ROUTER CONFIGURATION TO {router.name} ===")
            logger.info(f"Config data keys: {list(config_data.keys())}")
            
            # Enable IP forwarding first
            result = router.cmd('echo 1 > /proc/sys/net/ipv4/ip_forward')
            logger.info(f"Enabled IP forwarding on {router.name} - Result: {result}")
            
            # Apply basic configuration
            basic_config = config_data.get('basic_config', {})
            if basic_config:
                hostname = basic_config.get('hostname')
                if hostname:
                    router.cmd(f'hostname {hostname}')
                    logger.debug(f"Set hostname to {hostname} on {router.name}")
            
            # Apply interface configurations from original config
            interface_config = config_data.get('interface_config', {})
            logger.info(f"Found {len(interface_config)} interface configurations")
            
            for interface_name, interface_settings in interface_config.items():
                logger.info(f"=== Configuring interface {interface_name} on {router.name} ===")
                logger.info(f"Interface settings: {interface_settings}")
                
                # Set IP address
                ip_address = interface_settings.get('ip_address')
                if ip_address:
                    logger.info(f"Setting IP {ip_address} on {interface_name}")
                    
                    # Clear any existing IP first
                    flush_result = router.cmd(f'ip addr flush dev {interface_name} 2>/dev/null || true')
                    logger.debug(f"Flush result: {flush_result}")
                    
                    # Add new IP
                    add_result = router.cmd(f'ip addr add {ip_address} dev {interface_name} 2>/dev/null || true')
                    logger.info(f"Add IP result: {add_result}")
                    
                    # Verify IP was set
                    verify_result = router.cmd(f'ip addr show {interface_name}')
                    logger.info(f"Interface {interface_name} after IP config: {verify_result}")
                else:
                    logger.warning(f"No IP address specified for interface {interface_name}")
                
                # Set interface status
                status = interface_settings.get('status', 'up')
                if status == 'up':
                    up_result = router.cmd(f'ip link set {interface_name} up')
                    logger.info(f"Brought up interface {interface_name} - Result: {up_result}")
                
                # Set MTU
                mtu = interface_settings.get('mtu')
                if mtu:
                    mtu_result = router.cmd(f'ip link set {interface_name} mtu {mtu}')
                    logger.info(f"Set MTU {mtu} on {interface_name} - Result: {mtu_result}")
            
            # ENHANCED: Restore comprehensive router state if available
            self._restore_comprehensive_router_state(router, config_data)
            
            # Apply static routes from original config
            static_routes = config_data.get('static_routes', [])
            for route in static_routes:
                destination = route.get('destination')
                next_hop = route.get('next_hop')
                interface = route.get('interface')
                
                if destination and next_hop:
                    route_cmd = f'ip route add {destination} via {next_hop}'
                    if interface:
                        route_cmd += f' dev {interface}'
                    router.cmd(f'{route_cmd} 2>/dev/null || true')
                    logger.info(f"Added route: {route_cmd}")
                elif destination and interface:
                    route_cmd = f'ip route add {destination} dev {interface}'
                    router.cmd(f'{route_cmd} 2>/dev/null || true')
                    logger.info(f"Added route: {route_cmd}")
            
            # ENHANCED: Also restore captured routing state if available
            captured_routing_state = config_data.get('captured_routing_state', {})
            if captured_routing_state:
                logger.info(f"Restoring captured routing state for {router.name}")
                
                # Restore routes
                routes = captured_routing_state.get('routes', [])
                for route in routes:
                    router.cmd(f'ip route add {route} 2>/dev/null || true')
                    logger.debug(f"Restored route: {route}")
                
                # Restore default route
                default_route = captured_routing_state.get('default_route')
                if default_route:
                    router.cmd(f'ip route add {default_route} 2>/dev/null || true')
                    logger.debug(f"Restored default route: {default_route}")
                
                # Restore IP forwarding state
                if captured_routing_state.get('ip_forwarding'):
                    router.cmd('echo 1 > /proc/sys/net/ipv4/ip_forward')
                    logger.debug("Restored IP forwarding enabled state")
            
            # Apply firewall configuration
            firewall_config = config_data.get('firewall_config', {})
            if firewall_config:
                logger.info(f"Applying firewall configuration to {router.name}")
                
                # Clear existing rules
                router.cmd('iptables -F 2>/dev/null || true')
                router.cmd('iptables -X 2>/dev/null || true')
                
                # Apply rules
                rules = firewall_config.get('rules', [])
                for rule in rules:
                    rule_cmd = rule.get('rule', '')
                    if rule_cmd:
                        router.cmd(f'iptables {rule_cmd} 2>/dev/null || true')
                        logger.debug(f"Applied firewall rule: {rule_cmd}")
                
                # Set default policies
                input_policy = firewall_config.get('default_input', 'ACCEPT')
                forward_policy = firewall_config.get('default_forward', 'ACCEPT')
                output_policy = firewall_config.get('default_output', 'ACCEPT')
                
                router.cmd(f'iptables -P INPUT {input_policy} 2>/dev/null || true')
                router.cmd(f'iptables -P FORWARD {forward_policy} 2>/dev/null || true')
                router.cmd(f'iptables -P OUTPUT {output_policy} 2>/dev/null || true')
            
            # Apply NAT configuration
            nat_config = config_data.get('nat_config', {})
            if nat_config:
                logger.info(f"Applying NAT configuration to {router.name}")
                
                masquerade_interfaces = nat_config.get('masquerade_interfaces', [])
                for interface in masquerade_interfaces:
                    router.cmd(f'iptables -t nat -A POSTROUTING -o {interface} -j MASQUERADE 2>/dev/null || true')
                    logger.debug(f"Enabled NAT masquerade on {interface}")
                
                port_forwards = nat_config.get('port_forwards', [])
                for pf in port_forwards:
                    external_port = pf.get('external_port')
                    internal_ip = pf.get('internal_ip')
                    internal_port = pf.get('internal_port')
                    protocol = pf.get('protocol', 'tcp')
                    
                    if external_port and internal_ip and internal_port:
                        router.cmd(f'iptables -t nat -A PREROUTING -p {protocol} --dport {external_port} -j DNAT --to-destination {internal_ip}:{internal_port} 2>/dev/null || true')
                        logger.debug(f"Added port forward: {external_port} -> {internal_ip}:{internal_port}")
            
            # Apply protocol configuration (OSPF, BGP, etc.)
            protocol_config = config_data.get('protocol_config', {})
            if protocol_config:
                # This would require specific routing daemon setup
                logger.debug(f"Protocol configuration present for {router.name} (requires routing daemon)")
            
            logger.info(f"Router configuration applied successfully to {router.name}")
            
        except Exception as e:
            logger.error(f"Error applying router configuration to {router.name}: {e}")
    
    def _apply_host_configuration(self, host, config_data):
        """Apply host-specific configuration"""
        try:
            logger.debug(f"Applying host configuration to {host.name}")
            
            # Apply interface configurations
            interface_config = config_data.get('interface_config', {})
            for interface_name, interface_settings in interface_config.items():
                ip_address = interface_settings.get('ip_address')
                if ip_address:
                    host.cmd(f'ip addr add {ip_address} dev {interface_name} 2>/dev/null || true')
                
                status = interface_settings.get('status', 'up')
                if status == 'up':
                    host.cmd(f'ip link set {interface_name} up')
            
            # Apply DNS configuration
            dns_config = config_data.get('dns_config', {})
            if dns_config:
                nameservers = dns_config.get('nameservers', [])
                if nameservers:
                    resolv_conf = '\n'.join([f'nameserver {ns}' for ns in nameservers])
                    host.cmd(f'echo "{resolv_conf}" > /etc/resolv.conf')
            
            # Apply service configurations
            service_config = config_data.get('service_config', {})
            if service_config:
                services = service_config.get('services', [])
                for service in services:
                    service_name = service.get('name')
                    action = service.get('action')
                    if service_name and action == 'start':
                        host.cmd(f'systemctl start {service_name} 2>/dev/null || true')
            
        except Exception as e:
            logger.error(f"Error applying host configuration to {host.name}: {e}")
    
    def _apply_switch_configuration(self, switch, config_data):
        """Apply switch-specific configuration"""
        try:
            logger.debug(f"Applying switch configuration to {switch.name}")
            
            # Apply OpenFlow configuration
            openflow_config = config_data.get('openflow_config', {})
            if openflow_config:
                version = openflow_config.get('version', '1.3')
                switch.cmd(f'ovs-vsctl set bridge {switch.name} protocols=OpenFlow{version.replace(".", "")} 2>/dev/null || true')
            
            # Apply port configurations
            port_config = config_data.get('port_config', {})
            for port_name, port_settings in port_config.items():
                # This would configure specific port settings
                logger.debug(f"Port configuration for {port_name} on {switch.name}")
            
        except Exception as e:
            logger.error(f"Error applying switch configuration to {switch.name}: {e}")
    
    def _restore_comprehensive_router_state(self, router, config_data):
        """Restore comprehensive router state from captured data"""
        try:
            logger.info(f"=== RESTORING COMPREHENSIVE ROUTER STATE FOR {router.name} ===")
            
            # Check if we have comprehensive router state data
            router_state = None
            
            # Look for router state in different locations
            if 'router_states' in config_data:
                router_state = config_data['router_states']
            elif 'captured_interface_state' in config_data or 'captured_routing_state' in config_data:
                # Fallback to old format
                router_state = {
                    'interfaces': config_data.get('captured_interface_state', {}),
                    'routing': config_data.get('captured_routing_state', {})
                }
            
            if not router_state:
                logger.warning(f"No comprehensive router state data found for {router.name}")
                return
            
            logger.info(f"Found router state data with keys: {list(router_state.keys())}")
            
            # 1. RESTORE INTERFACE STATES
            interfaces = router_state.get('interfaces', {})
            if interfaces:
                logger.info(f"Restoring {len(interfaces)} interfaces for {router.name}")
                
                for interface_name, interface_info in interfaces.items():
                    logger.info(f"--- Restoring interface {interface_name} ---")
                    
                    # Restore IP addresses
                    ip_addresses = interface_info.get('ip_addresses', [])
                    for ip_addr in ip_addresses:
                        logger.info(f"Restoring IP {ip_addr} on {interface_name}")
                        result = router.cmd(f'ip addr add {ip_addr} dev {interface_name} 2>/dev/null || true')
                        logger.debug(f"IP restore result: {result}")
                    
                    # Restore interface status
                    if interface_info.get('status') == 'up':
                        logger.info(f"Bringing up interface {interface_name}")
                        router.cmd(f'ip link set {interface_name} up')
                    
                    # Restore MTU
                    mtu = interface_info.get('mtu')
                    if mtu:
                        logger.info(f"Setting MTU {mtu} on {interface_name}")
                        router.cmd(f'ip link set {interface_name} mtu {mtu}')
            
            # 2. RESTORE ROUTING STATE
            routing = router_state.get('routing', {})
            if routing:
                logger.info(f"Restoring routing state for {router.name}")
                
                # Restore IP forwarding
                if routing.get('ip_forwarding_enabled'):
                    logger.info("Enabling IP forwarding")
                    router.cmd('echo 1 > /proc/sys/net/ipv4/ip_forward')
                
                # Restore routes
                routes = routing.get('routes', [])
                for route in routes:
                    if route and not route.startswith('default'):  # Skip default routes for now
                        logger.debug(f"Restoring route: {route}")
                        router.cmd(f'ip route add {route} 2>/dev/null || true')
                
                # Restore default route
                default_route = routing.get('default_route')
                if default_route:
                    logger.info(f"Restoring default route: {default_route}")
                    router.cmd(f'ip route add {default_route} 2>/dev/null || true')
            
            # 3. RESTORE FIREWALL STATE
            firewall = router_state.get('firewall', {})
            if firewall:
                logger.info(f"Restoring firewall state for {router.name}")
                
                # Clear existing rules first
                router.cmd('iptables -F 2>/dev/null || true')
                router.cmd('iptables -t nat -F 2>/dev/null || true')
                router.cmd('iptables -t mangle -F 2>/dev/null || true')
                
                # Restore filter rules
                filter_rules = firewall.get('filter_rules', [])
                self._restore_iptables_rules(router, filter_rules, 'filter')
                
                # Restore NAT rules
                nat_rules = firewall.get('nat_rules', [])
                self._restore_iptables_rules(router, nat_rules, 'nat')
                
                # Restore mangle rules
                mangle_rules = firewall.get('mangle_rules', [])
                self._restore_iptables_rules(router, mangle_rules, 'mangle')
            
            # 4. RESTORE PROTOCOL STATE
            protocols = router_state.get('protocols', {})
            if protocols:
                logger.info(f"Protocol state found for {router.name}")
                running_processes = protocols.get('running_processes', [])
                if running_processes:
                    logger.info(f"Router had running protocol processes: {running_processes}")
                    # Note: We don't restart protocol daemons as they might not be available
                    # This is informational for now
            
            # 5. RESTORE SYSTEM STATE
            system = router_state.get('system', {})
            if system:
                logger.info(f"Restoring system state for {router.name}")
                
                # Restore hostname
                hostname = system.get('hostname')
                if hostname and hostname != router.name:
                    logger.info(f"Setting hostname to {hostname}")
                    router.cmd(f'hostname {hostname}')
                
                # Restore DNS configuration
                dns_config = system.get('dns_config', [])
                if dns_config:
                    logger.info("Restoring DNS configuration")
                    dns_content = '\n'.join(dns_config)
                    router.cmd(f'echo "{dns_content}" > /etc/resolv.conf 2>/dev/null || true')
            
            logger.info(f"Completed comprehensive router state restoration for {router.name}")
            
        except Exception as e:
            logger.error(f"Error restoring comprehensive router state for {router.name}: {e}")
            import traceback
            logger.error(f"Traceback: {traceback.format_exc()}")
    
    def _restore_iptables_rules(self, router, rules, table='filter'):
        """Restore iptables rules for a specific table"""
        try:
            if not rules:
                return
            
            logger.debug(f"Restoring {len(rules)} iptables rules for table {table}")
            
            table_arg = f'-t {table}' if table != 'filter' else ''
            
            for rule_line in rules:
                # Skip header lines and empty lines
                if not rule_line.strip() or rule_line.startswith('Chain') or rule_line.startswith('target'):
                    continue
                
                # This is a simplified rule restoration
                # In a full implementation, you'd parse the rule format and convert back to iptables commands
                logger.debug(f"Rule line: {rule_line}")
                # For now, we just log the rules that were present
                
        except Exception as e:
            logger.warning(f"Error restoring iptables rules for table {table}: {e}")
    
    def _apply_terminal_command(self, device, command_entry):
        """Apply a terminal command to a device"""
        try:
            command = command_entry.get('command', '')
            if command and not command.startswith('#'):  # Skip comments
                logger.debug(f"Executing command on {device.name}: {command}")
                # Execute the command (be careful with dangerous commands)
                if self._is_safe_command(command):
                    result = device.cmd(command)
                    logger.debug(f"Command result: {result}")
                else:
                    logger.warning(f"Skipping potentially unsafe command: {command}")
                    
        except Exception as e:
            logger.warning(f"Error applying terminal command to {device.name}: {e}")
    
    def _is_safe_command(self, command: str) -> bool:
        """Check if a command is safe to execute during restoration"""
        # List of dangerous commands to avoid
        dangerous_commands = [
            'rm ', 'rmdir', 'dd ', 'mkfs', 'fdisk', 'parted',
            'shutdown', 'reboot', 'halt', 'poweroff',
            'kill ', 'killall', 'pkill',
            'passwd', 'su ', 'sudo ',
            'chmod 777', 'chown root',
            'wget ', 'curl ', 'nc ', 'netcat'
        ]

        # List of safe commands to allow
        safe_commands = [
            'ip ', 'ifconfig', 'route',
            'iptables', 'tc ',
            'echo ', 'cat ', 'grep',
            'systemctl start', 'systemctl enable', 'systemctl restart',
            'service start', 'service enable', 'service restart'
        ]

        command_lower = command.lower().strip()

        # Check for dangerous commands
        for dangerous in dangerous_commands:
            if dangerous in command_lower:
                return False

        # Allow safe commands
        for safe in safe_commands:
            if command_lower.startswith(safe):
                return True

        # Default to safe for basic commands
        return len(command_lower) < 100 and not any(char in command_lower for char in ['|', '>', '<', ';', '&', '`', '$'])