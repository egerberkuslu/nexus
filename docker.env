# Mininet Web Framework Docker Environment Configuration

# Database Configuration
MONGODB_URI=mongodb://mongodb:27017/
DATABASE_NAME=mininet_web_framework

# Application Configuration
FLASK_ENV=production
PYTHONPATH=/app
SECRET_KEY=your-secret-key-here

# Controller Configuration
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
POX_HOME=/opt/pox
ODL_HOME=/opt/opendaylight

# OpenDaylight Configuration
ODL_REST_PORT=8181
ODL_SSH_PORT=8101
ODL_OPENFLOW_PORT=6633

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000

# Network Configuration
MININET_NETWORK_SUBNET=172.20.0.0/16

# Security (Change these in production!)
ODL_SSH_USER=karaf
ODL_SSH_PASSWORD=karaf
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=password

# Performance Tuning
ODL_MAX_MEMORY=2048m
ODL_MIN_MEMORY=512m
MONGODB_CACHE_SIZE=256m
