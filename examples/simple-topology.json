{
  "name": "Simple Three-Node Topology",
  "description": "Basic topology with 2 hosts and 1 switch",
  "version": "1.0",
  "metadata": {
    "author": "Caduceus-Flux",
    "created": "2024-01-01",
    "tags": ["simple", "basic", "learning"]
  },
  "nodes": [
    {
      "name": "h1",
      "device_type": "host",
      "x": 100,
      "y": 200,
      "properties": {
        "ip": "10.0.0.1/24",
        "mac": "00:00:00:00:00:01",
        "default_route": "via 10.0.0.254"
      }
    },
    {
      "name": "h2",
      "device_type": "host",
      "x": 300,
      "y": 200,
      "properties": {
        "ip": "10.0.0.2/24",
        "mac": "00:00:00:00:00:02",
        "default_route": "via 10.0.0.254"
      }
    },
    {
      "name": "s1",
      "device_type": "switch",
      "x": 200,
      "y": 100,
      "properties": {
        "switch_type": "ovs",
        "openflow_version": "1.3",
        "datapath_id": "0000000000000001"
      }
    }
  ],
  "links": [
    {
      "source_node_id": "h1",
      "target_node_id": "s1",
      "source_port": "h1-eth0",
      "target_port": "s1-eth1",
      "bandwidth": 100,
      "delay": 1,
      "loss": 0,
      "max_queue_size": 1000,
      "properties": {}
    },
    {
      "source_node_id": "h2",
      "target_node_id": "s1",
      "source_port": "h2-eth0",
      "target_port": "s1-eth2",
      "bandwidth": 100,
      "delay": 1,
      "loss": 0,
      "max_queue_size": 1000,
      "properties": {}
    }
  ],
  "controllers": [
    {
      "name": "c0",
      "controller_type": "osken",
      "ip": "127.0.0.1",
      "port": 6653,
      "properties": {}
    }
  ],
  "protocols": {},
  "options": {
    "autoSetMacs": true,
    "xterms": false,
    "ipBase": "10.0.0.0/24"
  }
}
