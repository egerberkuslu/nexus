# Environment Configuration for Mininet Web Framework

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=mininet_web_framework

# Optional: MongoDB Authentication (if enabled)
# MONGODB_USERNAME=your_username
# MONGODB_PASSWORD=your_password

# Backend Configuration
FLASK_ENV=production
PYTHONPATH=/app

# Application Settings
AUTO_SAVE_TOPOLOGIES=false
AUTO_SAVE_CONFIGURATIONS=false

# Frontend Configuration (for development)
REACT_APP_API_URL=http://localhost:5000

# Docker Network Configuration
DOCKER_NETWORK_SUBNET=172.20.0.0/16

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/mininet-web-framework/app.log
