{
  "dashboard": {
    "title": "Caduceus-Flux Topology Overview",
    "tags": ["caduceus-flux", "topology", "network"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Active Devices",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "count(up{component=\"network\"} == 1)",
            "legendFormat": "Active Devices"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        }
      },
      {
        "id": 2,
        "title": "Total Traffic (MB/s)",
        "type": "stat",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(interface_tx_bytes_total[1m]) + rate(interface_rx_bytes_total[1m])) / 1024 / 1024",
            "legendFormat": "Traffic"
          }
        ]
      },
      {
        "id": 3,
        "title": "Packet Loss Rate",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(interface_rx_errors_total[5m])) / sum(rate(interface_rx_packets_total[5m]))",
            "legendFormat": "Loss Rate"
          }
        ],
        "options": {
          "maxValue": 0.1,
          "thresholds": [
            {"value": 0, "color": "green"},
            {"value": 0.01, "color": "yellow"},
            {"value": 0.05, "color": "red"}
          ]
        }
      },
      {
        "id": 4,
        "title": "Active Links",
        "type": "stat",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "count(interface_status{status=\"up\"} == 1)",
            "legendFormat": "Active Links"
          }
        ]
      },
      {
        "id": 5,
        "title": "Network Traffic Over Time",
        "type": "graph",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(interface_tx_bytes_total[1m])) by (device) / 1024 / 1024",
            "legendFormat": "{{device}} TX"
          },
          {
            "expr": "sum(rate(interface_rx_bytes_total[1m])) by (device) / 1024 / 1024",
            "legendFormat": "{{device}} RX"
          }
        ],
        "yaxes": [
          {"format": "MBs", "label": "Traffic"}
        ]
      },
      {
        "id": 6,
        "title": "Device CPU Usage",
        "type": "graph",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "device_cpu_percent",
            "legendFormat": "{{device}}"
          }
        ],
        "yaxes": [
          {"format": "percent", "max": 100}
        ]
      },
      {
        "id": 7,
        "title": "Protocol Status",
        "type": "table",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "protocol_status",
            "format": "table",
            "instant": true
          }
        ]
      },
      {
        "id": 8,
        "title": "Interface Status",
        "type": "table",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "interface_status",
            "format": "table",
            "instant": true
          }
        ]
      }
    ]
  }
}

