    def execute_opendaylight_command(self, command, timeout=30):
        """Execute a karaf command on OpenDaylight"""
        if 'opendaylight' in self.controller_factory.controllers:
            return self.controller_factory.controllers['opendaylight'].execute_karaf_command(command, timeout)
        return {'error': 'OpenDaylight controller not available'}

    def list_opendaylight_features(self):
